# Copy to .env and fill in.  Never commit real keys.
# Create API keys in OKX with "Trade" permission.  For paper testing use the
# OKX Demo Trading environment keys and keep OKX_DEMO=1.

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# 1 = OKX demo (paper) trading, 0 = real funds
OKX_DEMO=1

# dry-run = no orders placed (logs intended trades) | live = places real orders
BOT_MODE=dry-run
