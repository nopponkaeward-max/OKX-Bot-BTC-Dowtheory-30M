        if not na(p2ExLn)
            line.set_x1(p2ExLn, bar_index + 2)
            line.set_x2(p2ExLn, bar_index + 20)
        line p2ExTp = array.get(p2PendTpLn, p2i)
        if not na(p2ExTp)
            line.set_x1(p2ExTp, bar_index + 2)
            line.set_x2(p2ExTp, bar_index + 20)
        line p2ExSl = array.get(p2PendSlLn, p2i)
        if not na(p2ExSl)
            line.set_x1(p2ExSl, bar_index + 2)
            line.set_x2(p2ExSl, bar_index + 20)
        label p2ExLb = array.get(p2PendLb, p2i)
        if not na(p2ExLb)
            label.set_x(p2ExLb, bar_index + 20)
        label p2ExTpLb = array.get(p2PendTpLb, p2i)
        if not na(p2ExTpLb)
            label.set_x(p2ExTpLb, bar_index + 20)
        label p2ExSlLb = array.get(p2PendSlLb, p2i)
        if not na(p2ExSlLb)
            label.set_x(p2ExSlLb, bar_index + 20)
        bool p2Triggered = p2IsB ? (high >= p2Ent) : (low <= p2Ent)
        if p2Triggered
            // Spread: ปรับ entry ตามทิศทาง
            p2Ent += p2IsB ? spreadPts : -spreadPts
            float p2OneR    = oneRDistOf(p2Range)
            float p2SLprice = slEdgeMode ? (p2IsB ? p2Orig - p2Range : p2Orig + p2Range) : (p2IsB ? p2Ent - p2OneR : p2Ent + p2OneR)
            float p2RiskD   = math.abs(p2Ent - p2SLprice)
            float p2RR = use2ndCustomRR ? secondRR : rrRatio
            float p2RewardBase = rrBaseMode == "SL Distance" ? p2RiskD : p2OneR
            float p2TPprice = p2IsB ? p2Ent + (p2RewardBase * p2RR) : p2Ent - (p2RewardBase * p2RR)
            float p2Lot     = p2OneR > 0 ? riskAmount / (p2OneR * pipValueRatio) : 0
            float p2TrdRR   = p2OneR > 0 ? math.abs(p2TPprice - p2Ent) / p2OneR : 0
            box p2TpBx = box.new(left=bar_index, top=p2IsB ? p2TPprice : p2Ent, right=bar_index + 15, bottom=p2IsB ? p2Ent : p2TPprice, bgcolor=showTpSlBox ? color.new(color.green, 88) : color.new(color.green, 100), border_color=showTpSlBox ? color.new(color.green, 50) : color.new(color.green, 100))
            box p2SlBx = box.new(left=bar_index, top=p2IsB ? p2Ent : p2SLprice, right=bar_index + 15, bottom=p2IsB ? p2SLprice : p2Ent, bgcolor=showTpSlBox ? color.new(color.red, 88) : color.new(color.red, 100), border_color=showTpSlBox ? color.new(color.red, 50) : color.new(color.red, 100))
            regBox(p2TpBx), regBox(p2SlBx)
            array.push(tIsBuy, p2IsB)
            array.push(tEntry, p2Ent)
            array.push(tSL, p2SLprice)
            array.push(tTP, p2TPprice)
            array.push(tBarIdx, bar_index)
            array.push(tPipsDist, p2OneR)
            array.push(tTradeRR, p2TrdRR)
            array.push(tIsSmall, p2Small)
            array.push(tIsRec, false)
            array.push(tIs2nd, true)
            array.push(tIsAddon, false)
            array.push(tTrailed, false)
            array.push(tSlR, -1.0)
            array.push(tSlBox, p2SlBx)
            array.push(tTrailLn, na)
            array.push(tAoTpLbl, na), array.push(tAoSlLbl, na), array.push(tAoTpLn, na), array.push(tAoSlLn, na), array.push(tAddonTPd, false)
            array.push(tSesRange, p2Range)
            array.push(tSesName, p2Name)
            array.push(tOriginTime, time)
            array.push(tOrigEntry, p2Orig)
            sig2ndOpen := true
            alert("ออเดอร์ที่ 3 " + (p2IsB ? "Buy" : "Sell") + " | Entry: " + str.tostring(p2Ent, format.mintick) + " | TP: " + str.tostring(p2TPprice, format.mintick) + " | SL: " + str.tostring(p2SLprice, format.mintick) + " | Lot: " + str.tostring(p2Lot, "#.##"), alert.freq_once_per_bar)
            string p2InfoText = "ออเดอร์ที่ 3 " + (p2IsB ? "Buy" : "Sell") + "\\nSize: " + str.tostring(p2Lot, "#.##") + " Lots\\nTP: " + str.tostring(p2TrdRR, "#.##") + "R"
            regLabel(label.new(x=bar_index, y=p2Ent, text=p2InfoText, color=color.new(color.yellow, 60), textcolor=color.black, style=p2IsB ? label.style_label_up : label.style_label_down, size=orderLabelSize))
            regLabel(label.new(x=bar_index, y=p2Ent, text="", style=label.style_circle, color=color.new(color.yellow, 60), size=size.large))
            line p2TpArr = line.new(x1=bar_index, y1=p2Ent, x2=bar_index, y2=p2TPprice, color=color.new(color.green, 70), width=1, style=line.style_arrow_right)
            line p2SlArr = line.new(x1=bar_index, y1=p2Ent, x2=bar_index, y2=p2SLprice, color=color.new(color.red, 70), width=1, style=line.style_arrow_right)
            regLine(p2TpArr), regLine(p2SlArr)
            string p2FmtEnt = str.tostring(p2Ent, format.mintick)
            string p2FmtTp  = str.tostring(p2TPprice, format.mintick)
            string p2FmtSl  = str.tostring(p2SLprice, format.mintick)
            regLine(line.new(x1=bar_index, y1=p2Ent, x2=bar_index + 20, y2=p2Ent, color=color.new(color.yellow, 30), width=2))
            line p2FillTpLn = line.new(x1=bar_index, y1=p2TPprice, x2=bar_index + 20, y2=p2TPprice, color=color.new(color.yellow, 30), width=2)
            line p2FillSlLn = line.new(x1=bar_index, y1=p2SLprice, x2=bar_index + 20, y2=p2SLprice, color=color.new(color.yellow, 30), width=2)
            regLine(p2FillTpLn), regLine(p2FillSlLn)
            regLabel(label.new(x=bar_index + 20, y=p2Ent, text=p2FmtEnt, style=label.style_label_left, color=color.new(color.yellow, 40), textcolor=color.black, size=size.small))
            label p2FillTpLbl = label.new(x=bar_index + 20, y=p2TPprice, text="TP ออเดอร์ที่ 3 " + p2FmtTp, style=label.style_label_left, color=color.new(color.yellow, 40), textcolor=color.black, size=size.small)
            label p2FillSlLbl = label.new(x=bar_index + 20, y=p2SLprice, text="SL ออเดอร์ที่ 3 " + p2FmtSl, style=label.style_label_left, color=color.new(color.yellow, 40), textcolor=color.black, size=size.small)
            regLabel(p2FillTpLbl), regLabel(p2FillSlLbl)
            array.set(tAoTpLbl, array.size(tAoTpLbl) - 1, p2FillTpLbl)
            array.set(tAoSlLbl, array.size(tAoSlLbl) - 1, p2FillSlLbl)
            array.set(tAoTpLn,  array.size(tAoTpLn)  - 1, p2FillTpLn)
            array.set(tAoSlLn,  array.size(tAoSlLn)  - 1, p2FillSlLn)
            // pending re-break preview has become a live order → remove its line + label
            line.delete(array.get(p2PendLn, p2i))
            line.delete(array.get(p2PendTpLn, p2i))
            line.delete(array.get(p2PendSlLn, p2i))
            label.delete(array.get(p2PendLb, p2i))
            label.delete(array.get(p2PendTpLb, p2i))
            label.delete(array.get(p2PendSlLb, p2i))
            array.remove(p2IsBuy, p2i), array.remove(p2Entry, p2i), array.remove(p2SesRange, p2i)
            array.remove(p2SesName, p2i), array.remove(p2OriginTime, p2i), array.remove(p2IsSmall, p2i), array.remove(p2OrigEntry, p2i), array.remove(p2PendLn, p2i), array.remove(p2PendLb, p2i)
            array.remove(p2PendTpLn, p2i), array.remove(p2PendSlLn, p2i), array.remove(p2PendTpLb, p2i), array.remove(p2PendSlLb, p2i)
        p2i -= 1
// ==========================================

// --- 5C. 50% ADD-ON TRIGGER ---

// ==========================================

if useAddOn50 and array.size(aoLevel) > 0
    int aoi = array.size(aoLevel) - 1
    while aoi >= 0
        bool  aIsB      = array.get(aoIsBuy, aoi)
        float aLvl      = array.get(aoLevel, aoi)
        int   aOrigTime = array.get(aoOriginTime, aoi)
        string aName    = array.get(aoSesName, aoi)
        // Keep the purple dashed add-on lines (entry/TP/SL) to the right of the current bar (moves each bar)
        line aExistLn = array.get(aoLn, aoi)
        if not na(aExistLn)
            line.set_x1(aExistLn, bar_index + 2)
            line.set_x2(aExistLn, bar_index + 10)
        line aExistTp = array.get(aoTpLn, aoi)
        if not na(aExistTp)
            line.set_x1(aExistTp, bar_index + 2)
            line.set_x2(aExistTp, bar_index + 10)
        line aExistSl = array.get(aoSlLn, aoi)
        if not na(aExistSl)
            line.set_x1(aExistSl, bar_index + 2)
            line.set_x2(aExistSl, bar_index + 10)
        // Require a bar strictly AFTER the arming (breakout) bar — a breakout bar that also
        // wicks to the 50% level must not open the add-on on the same bar.
        bool aHit = time > aOrigTime and (aIsB ? (low <= aLvl) : (high >= aLvl))
        if aHit
            // Only open add-on if the MAIN order is still live (not yet TP/SL)
            bool mainAlive = false
            int  mainIdx   = -1
            if array.size(tOriginTime) > 0
                for k = 0 to array.size(tOriginTime) - 1
                    if not array.get(tIs2nd, k) and not array.get(tIsRec, k) and array.get(tIsBuy, k) == aIsB and array.get(tOriginTime, k) == aOrigTime and array.get(tSesName, k) == aName
                        mainAlive := true
                        mainIdx   := k
                        break
            if mainAlive
                float aRange    = array.get(aoSesRange, aoi)
                bool  aSmall    = array.get(aoIsSmall, aoi)
                float aEntry    = aLvl + (aIsB ? spreadPts : -spreadPts)
                float aSLprice  = array.get(aoSL, aoi)   // same SL as main
                float aRiskD    = math.abs(aEntry - aSLprice)
                float aTPprice  = aoTpMode == "R:R Ratio" ? (aIsB ? aEntry + aRiskD * aoRR : aEntry - aRiskD * aoRR) : array.get(aoTP, aoi)
                float aLot      = aRiskD > 0 ? riskAmount / (aRiskD * pipValueRatio) : 0
                float aTrdRR    = aRiskD > 0 ? math.abs(aTPprice - aEntry) / aRiskD : 0
                box aTpBx = box.new(left=bar_index, top=aIsB ? aTPprice : aEntry, right=bar_index + 15, bottom=aIsB ? aEntry : aTPprice, bgcolor=showTpSlBox ? color.new(color.purple, 88) : color.new(color.purple, 100), border_color=showTpSlBox ? color.new(color.purple, 50) : color.new(color.purple, 100))
                box aSlBx = box.new(left=bar_index, top=aIsB ? aEntry : aSLprice, right=bar_index + 15, bottom=aIsB ? aSLprice : aEntry, bgcolor=showTpSlBox ? color.new(color.purple, 88) : color.new(color.purple, 100), border_color=showTpSlBox ? color.new(color.purple, 50) : color.new(color.purple, 100))
                regBox(aTpBx), regBox(aSlBx)
                array.push(tIsBuy, aIsB)
                array.push(tEntry, aEntry)
                array.push(tSL, aSLprice)
                array.push(tTP, aTPprice)
                array.push(tBarIdx, bar_index)
                array.push(tPipsDist, aRiskD)
                array.push(tTradeRR, aTrdRR)
                array.push(tIsSmall, aSmall)
                array.push(tIsRec, false)
                array.push(tIs2nd, true)
                array.push(tIsAddon, true)
                array.push(tTrailed, false)
                array.push(tSlR, -1.0)
                array.push(tSlBox, aSlBx)
                array.push(tTrailLn, na)
                array.push(tAoTpLbl, na), array.push(tAoSlLbl, na), array.push(tAoTpLn, na), array.push(tAoSlLn, na), array.push(tAddonTPd, false)
                array.push(tSesRange, aRange)
                array.push(tSesName, aName)
                array.push(tOriginTime, time)
                array.push(tOrigEntry, array.get(aoTP, aoi))
                sigAddOn := true
                alert("ออเดอร์ที่ 2 Add-on " + (aIsB ? "Buy" : "Sell") + " | Entry: " + str.tostring(aEntry, format.mintick) + " | TP: " + str.tostring(aTPprice, format.mintick) + " | SL: " + str.tostring(aSLprice, format.mintick) + " | Lot: " + str.tostring(aLot, "#.##"), alert.freq_once_per_bar)
                string aoTpTxt = aoTpMode == "R:R Ratio" ? str.tostring(aTrdRR, "#.##") + "R" : "ราคาทุน main"
                string aInfoText = "ออเดอร์ที่ 2 Add-on " + (aIsB ? "Buy" : "Sell") + "\\nSize: " + str.tostring(aLot, "#.##") + " Lots\\nTP: " + aoTpTxt
                regLabel(label.new(x=bar_index, y=aEntry, text=aInfoText, color=color.new(color.purple, 60), textcolor=color.white, style=aIsB ? label.style_label_up : label.style_label_down, size=orderLabelSize))
                regLabel(label.new(x=bar_index, y=aEntry, text="", style=label.style_circle, color=color.new(color.purple, 70), size=size.large))
                regLine(line.new(x1=bar_index, y1=aEntry, x2=bar_index, y2=aTPprice, color=color.new(color.purple, 70), width=1, style=line.style_dashed))
                regLine(line.new(x1=bar_index, y1=aEntry, x2=bar_index, y2=aSLprice, color=color.new(color.purple, 70), width=1, style=line.style_dashed))
                string aFmtEnt = str.tostring(aEntry, format.mintick)
                string aFmtTp  = str.tostring(aTPprice, format.mintick)
                string aFmtSl  = str.tostring(aSLprice, format.mintick)
                regLine(line.new(x1=bar_index, y1=aEntry, x2=bar_index + 15, y2=aEntry, color=color.new(color.purple, 30), width=2, style=line.style_dashed))
                line aoFillTpLn = line.new(x1=bar_index, y1=aTPprice, x2=bar_index + 15, y2=aTPprice, color=color.new(color.purple, 30), width=2, style=line.style_dashed)
                line aoFillSlLn = line.new(x1=bar_index, y1=aSLprice, x2=bar_index + 15, y2=aSLprice, color=color.new(color.purple, 30), width=2, style=line.style_dashed)
                regLine(aoFillTpLn), regLine(aoFillSlLn)
                regLabel(label.new(x=bar_index + 15, y=aEntry, text=aFmtEnt, style=label.style_label_left, color=color.new(color.purple, 40), textcolor=color.white, size=size.small))
                label aoFillTpLbl = label.new(x=bar_index + 15, y=aTPprice, text="TP ออเดอร์ที่ 2 " + aFmtTp, style=label.style_label_left, color=color.new(color.purple, 40), textcolor=color.white, size=size.small)
                label aoFillSlLbl = label.new(x=bar_index + 15, y=aSLprice, text="SL ออเดอร์ที่ 2 " + aFmtSl, style=label.style_label_left, color=color.new(color.purple, 40), textcolor=color.white, size=size.small)
                regLabel(aoFillTpLbl), regLabel(aoFillSlLbl)
                array.set(tAoTpLbl, array.size(tAoTpLbl) - 1, aoFillTpLbl)
                array.set(tAoSlLbl, array.size(tAoSlLbl) - 1, aoFillSlLbl)
                array.set(tAoTpLn,  array.size(tAoTpLn)  - 1, aoFillTpLn)
                array.set(tAoSlLn,  array.size(tAoSlLn)  - 1, aoFillSlLn)
                // Move main TP to break-even (entry price) when toggle is on
                if aoMainBE and mainIdx >= 0
                    float mainEnt = array.get(tEntry, mainIdx)
                    array.set(tTP, mainIdx, mainEnt)
                    array.set(tTradeRR, mainIdx, 0.0)
            // Remove pending (single-shot: opened, or main already closed)
            line.delete(array.get(aoLn, aoi))
            line.delete(array.get(aoTpLn, aoi))
            line.delete(array.get(aoSlLn, aoi))
            label.delete(array.get(aoLb, aoi))
            label.delete(array.get(aoTpLb, aoi))
            label.delete(array.get(aoSlLb, aoi))
            array.remove(aoIsBuy, aoi), array.remove(aoLevel, aoi), array.remove(aoTP, aoi)
            array.remove(aoSL, aoi), array.remove(aoSesRange, aoi), array.remove(aoSesName, aoi)
            array.remove(aoOriginTime, aoi), array.remove(aoIsSmall, aoi), array.remove(aoLn, aoi), array.remove(aoTpLn, aoi), array.remove(aoSlLn, aoi)
            array.remove(aoLb, aoi), array.remove(aoTpLb, aoi), array.remove(aoSlLb, aoi)
        aoi -= 1
// ==========================================

// --- 5D. ALERT CONDITIONS (named alerts for TradingView's Create Alert dialog) ---

// ==========================================

// These make the indicator's events selectable by name in TradingView's normal
// "Create Alert" → Condition dropdown, so a customer can route each to the app / email.
// (The direct alert(...) calls above still work via "Any alert() function call".)
alertcondition(sigNewOrder, title="เกิดออเดอร์ที่ 1 (Buy Stop / Sell Stop)", message="NPN-GOLD1-1: เกิดออเดอร์ที่ 1 (Buy Stop / Sell Stop) {{ticker}} {{interval}}")
alertcondition(sigFilled,   title="ออเดอร์ที่ 1 ถูกเปิด (Confirm)",             message="NPN-GOLD1-1: ออเดอร์ที่ 1 ถูกเปิด (Confirm) {{ticker}} {{interval}}")
alertcondition(sig2ndOpen,  title="เปิดออเดอร์ที่ 3 (Re-break)",                message="NPN-GOLD1-1: เปิดออเดอร์ที่ 3 (Re-break) {{ticker}} {{interval}}")
alertcondition(sigAddOn,    title="เปิดออเดอร์ที่ 2 (Add-on)",                   message="NPN-GOLD1-1: เปิดออเดอร์ที่ 2 (Add-on) {{ticker}} {{interval}}")

// ==========================================

// --- 6. TRADE RESULTS & TRAILING SL & ADAPTIVE RECOVERY ---

// ==========================================

if array.size(tEntry) > 0
    for i = array.size(tEntry) - 1 to 0
        if bar_index > array.get(tBarIdx, i)
            bool   isB       = array.get(tIsBuy, i)
            float  ent       = array.get(tEntry, i)
            float  sl        = array.get(tSL, i)
            float  tp        = array.get(tTP, i)
            bool   isRec     = array.get(tIsRec, i)
            bool   is2nd     = array.get(tIs2nd, i)
            bool   isAddon   = array.get(tIsAddon, i)
            float  dist      = array.get(tPipsDist, i)
            float  thisRR    = array.get(tTradeRR, i)
            bool   smMode    = array.get(tIsSmall, i)
            bool   trailed   = array.get(tTrailed, i)
            float  slR       = array.get(tSlR, i)
            float  sesRangeT = array.get(tSesRange, i)
            string sNameT    = array.get(tSesName, i)
            // === TRAILING SL CHECK ===
            bool  trailEnabled  = useTrail
            float trailTrigR    = trailTriggerR
            float trailLockRUse = trailLockR
            if trailEnabled and not trailed and dist > 0
                float trigPrice = isB ? ent + (dist * trailTrigR)    : ent - (dist * trailTrigR)
                float newSL     = isB ? ent + (dist * trailLockRUse) : ent - (dist * trailLockRUse)
                bool trailHit = isB ? (high >= trigPrice) : (low <= trigPrice)
                if trailHit
                    array.set(tSL, i, newSL)
                    array.set(tTrailed, i, true)
                    array.set(tSlR, i, trailLockRUse)
                    sl := newSL
                    trailed := true
                    slR := trailLockRUse
                    box oldSlBx = array.get(tSlBox, i)
                    if not na(oldSlBx)
                        box.delete(oldSlBx)
                        array.set(tSlBox, i, na)
                    line tLn = line.new(x1=array.get(tBarIdx, i), y1=newSL, x2=bar_index + 10, y2=newSL, color=color.orange, width=2, style=line.style_solid)
                    array.set(tTrailLn, i, tLn)
                    regLine(tLn)
                    string trTxt = "?? TRAIL SL → " + (trailLockRUse > 0 ? "+" : "") + str.tostring(trailLockRUse, "#.#") + "R"
                    regLabel(label.new(x=bar_index, y=newSL, text=trTxt, color=color.new(color.orange, 15), textcolor=color.white, style=isB ? label.style_label_down : label.style_label_up, size=orderLabelSize))
            line existTrLn = array.get(tTrailLn, i)
            if not na(existTrLn)
                line.set_x2(existTrLn, bar_index + 3)
            // === WIN/LOSS CHECK ===
            bool closedWin  = false
            bool closedLoss = false
            if isB
                if low <= sl
                    closedLoss := true
                else if high >= tp
                    closedWin := true
            else
                if high >= sl
                    closedLoss := true
                else if low <= tp
                    closedWin := true
            if closedWin or closedLoss
                bool isTrailStop = closedLoss and trailed
                // ระยะ SL จริง / ระยะ SL% (risk unit) → โหมดขอบที่กรอบกว้างกว่า SL% จะขาดทุนมากกว่า -1R
                float lossR    = dist > 0 ? -(math.abs(ent - sl) / dist) : -1.0
                float actualR = closedWin ? thisRR : (trailed ? slR : lossR)
                bool statAsWin  = actualR > 0
                string resultTag = isRec ? "Reco" : isAddon ? "ออเดอร์ที่ 2" : (is2nd ? "ออเดอร์ที่ 3" : "ออเดอร์ที่ 1")
                // Offset add-on close labels so they don't overlap the main's label at the same price/bar
                int   resLblX   = isAddon ? bar_index + 4 : bar_index
                bool willRecover = false
                bool recWillBeBuy = false
                float closePts   = closedWin ? math.abs(tp - ent) : math.abs(sl - ent)
                int   originTime = array.get(tOriginTime, i)
                array.push(resIsWin, statAsWin)
                array.push(resTradeRR, actualR)
                array.push(resTime, originTime)
                array.push(resIsSmall, smMode)
                array.push(resIsRec, isRec)
                array.push(resIs2nd, is2nd)
                array.push(resTpPts, closePts)
                if array.size(resIsWin) > 5000
                    array.shift(resIsWin)
                    array.shift(resTradeRR)
                    array.shift(resTime)
                    array.shift(resIsSmall)
                    array.shift(resIsRec)
                    array.shift(resIs2nd)
                    array.shift(resTpPts)
                if closedWin
                    regLabel(label.new(x=resLblX, y=tp, text="Win " + resultTag + "\\n+" + str.tostring(thisRR, "#.##") + "R", color=color.new(color.green, 20), textcolor=color.white, style=isB ? label.style_label_down : label.style_label_up, size=orderLabelSize))
                    regLine(line.new(x1=bar_index - 3, y1=tp, x2=bar_index + 3, y2=tp, color=color.green, width=2))
                else if isTrailStop and slR > 0
                    regLabel(label.new(x=resLblX, y=sl, text="Trail Win " + resultTag + "\\n+" + str.tostring(slR, "#.##") + "R", color=color.new(color.orange, 20), textcolor=color.white, style=isB ? label.style_label_up : label.style_label_down, size=orderLabelSize))
                    regLine(line.new(x1=bar_index - 3, y1=sl, x2=bar_index + 3, y2=sl, color=color.orange, width=2))
                else if isTrailStop and slR == 0
                    regLabel(label.new(x=resLblX, y=sl, text="BE " + resultTag + "\\n0R", color=color.new(color.gray, 20), textcolor=color.white, style=isB ? label.style_label_up : label.style_label_down, size=orderLabelSize))
                    regLine(line.new(x1=bar_index - 3, y1=sl, x2=bar_index + 3, y2=sl, color=color.gray, width=2))
                else
                    regLabel(label.new(x=resLblX, y=sl, text="Loss " + resultTag + "\\n" + str.tostring(lossR, "#.##") + "R", color=color.new(color.red, 20), textcolor=color.white, style=willRecover ? (recWillBeBuy ? label.style_label_down : label.style_label_up) : (isB ? label.style_label_up : label.style_label_down), size=orderLabelSize))
                    regLine(line.new(x1=bar_index - 3, y1=sl, x2=bar_index + 3, y2=sl, color=color.red, width=2))
                // === TRADE PATH LINE: จากบาร์เปิด → บาร์ปิด (TP หรือ SL) ===
                if showTradePath
                    float closePx = closedWin ? tp : sl
                    color pathCol = closedWin ? color.new(color.green, 60) : isTrailStop and slR > 0 ? color.new(color.orange, 60) : isTrailStop and slR == 0 ? color.new(color.gray, 60) : color.new(color.red, 60)
                    regLine(line.new(x1=array.get(tBarIdx, i), y1=ent, x2=bar_index, y2=closePx, color=pathCol, width=1, style=line.style_dashed))
                // === ADD-ON TP FLAG: if this closing trade is an Add-on that just won TP,
                // mark its parent Main so the 2nd-order rescue below won't arm on Main's later SL.
                // Match parent by (tSesName, tIsBuy, tOrigEntry) — Add-on and its Main share all three.
                if isAddon and closedWin and array.size(tEntry) > 0
                    float thisOrigEnt = array.get(tOrigEntry, i)
                    for k = 0 to array.size(tEntry) - 1
                        if not array.get(tIs2nd, k) and not array.get(tIsRec, k) and not array.get(tIsAddon, k) and array.get(tSesName, k) == sNameT and array.get(tIsBuy, k) == isB and array.get(tOrigEntry, k) == thisOrigEnt
                            array.set(tAddonTPd, k, true)
                            break
                // === 2ND ORDER PENDING: save for re-break ===
                // Only arm 2nd if this is Main hitting SL AND its Add-on didn't already win with TP.
                if use2ndOrder and not isRec and not is2nd and closedLoss and not isTrailStop and not array.get(tAddonTPd, i)
                    float origEntForP2 = array.get(tOrigEntry, i)
                    array.push(p2IsBuy, isB)
                    array.push(p2Entry, ent)
                    array.push(p2SesRange, sesRangeT)
                    array.push(p2SesName, sNameT)
                    array.push(p2OriginTime, time)
                    array.push(p2IsSmall, smMode)
                    array.push(p2OrigEntry, origEntForP2)
                    // Show the pending 2nd order from the main SL: a dashed level line + label at the
                    // re-break level (= main entry), plus dashed TP/SL preview lines at the projected
                    // 2nd-order levels so the customer sees where TP/SL will sit before it fills.
                    // All three lines track the bar and are cleared on trigger / session cancel.
                    float p2PrevOneR       = oneRDistOf(sesRangeT)
                    float p2PrevSL         = slEdgeMode ? (isB ? origEntForP2 - sesRangeT : origEntForP2 + sesRangeT) : (isB ? ent - p2PrevOneR : ent + p2PrevOneR)
                    float p2PrevRR         = use2ndCustomRR ? secondRR : rrRatio
                    float p2PrevRewardBase = rrBaseMode == "SL Distance" ? math.abs(ent - p2PrevSL) : p2PrevOneR
                    float p2PrevTP         = isB ? ent + (p2PrevRewardBase * p2PrevRR) : ent - (p2PrevRewardBase * p2PrevRR)
                    line  p2PLn   = line.new(x1=bar_index + 2, y1=ent,       x2=bar_index + 20, y2=ent,       color=color.new(color.yellow, 10), width=2, style=line.style_dashed)
                    line  p2PTpLn = line.new(x1=bar_index + 2, y1=p2PrevTP,  x2=bar_index + 20, y2=p2PrevTP,  color=color.new(color.green,  10), width=2, style=line.style_dashed)
                    line  p2PSlLn = line.new(x1=bar_index + 2, y1=p2PrevSL,  x2=bar_index + 20, y2=p2PrevSL,  color=color.new(color.red,    10), width=2, style=line.style_dashed)
                    label p2PLb   = label.new(x=bar_index + 20, y=ent, text="ออเดอร์ที่ 3 รอ Re-break: " + str.tostring(ent, format.mintick), style=label.style_label_left, color=color.new(color.yellow, 60), textcolor=color.black, size=orderLabelSizeSm)
                    label p2PTpLb = label.new(x=bar_index + 20, y=p2PrevTP, text="TP ออเดอร์ที่ 3 " + str.tostring(p2PrevTP, format.mintick), style=label.style_label_left, color=color.new(color.green, 60), textcolor=color.white, size=orderLabelSizeSm)
                    label p2PSlLb = label.new(x=bar_index + 20, y=p2PrevSL, text="SL ออเดอร์ที่ 3 " + str.tostring(p2PrevSL, format.mintick), style=label.style_label_left, color=color.new(color.red,   60), textcolor=color.white, size=orderLabelSizeSm)
                    array.push(p2PendLn, p2PLn)
                    array.push(p2PendLb, p2PLb)
                    array.push(p2PendTpLn, p2PTpLn)
                    array.push(p2PendSlLn, p2PSlLn)
                    array.push(p2PendTpLb, p2PTpLb)
                    array.push(p2PendSlLb, p2PSlLb)
                line finalTrLn = array.get(tTrailLn, i)
                if not na(finalTrLn)
                    line.delete(finalTrLn)
                box finalSlBx = array.get(tSlBox, i)
                if not na(finalSlBx)
                    box.set_right(finalSlBx, bar_index)
                // If the trade that just closed was the MAIN (not 2nd, not Add-on, not Reco), cancel
                // any Add-on pending armed by it — otherwise the preview labels/lines linger until
                // session end when price never returns to the 50% level again.
                if useAddOn50 and not isRec and not is2nd and not isAddon and array.size(aoOriginTime) > 0
                    int aox2 = array.size(aoOriginTime) - 1
                    int mainOrigT = array.get(tOriginTime, i)
                    while aox2 >= 0
                        if array.get(aoOriginTime, aox2) == mainOrigT and array.get(aoSesName, aox2) == sNameT and array.get(aoIsBuy, aox2) == isB
                            line.delete(array.get(aoLn, aox2))
                            line.delete(array.get(aoTpLn, aox2))
                            line.delete(array.get(aoSlLn, aox2))
                            label.delete(array.get(aoLb, aox2))
                            label.delete(array.get(aoTpLb, aox2))
                            label.delete(array.get(aoSlLb, aox2))
                            array.remove(aoIsBuy, aox2), array.remove(aoLevel, aox2), array.remove(aoTP, aox2)
                            array.remove(aoSL, aox2), array.remove(aoSesRange, aox2), array.remove(aoSesName, aox2)
                            array.remove(aoOriginTime, aox2), array.remove(aoIsSmall, aox2), array.remove(aoLn, aox2), array.remove(aoTpLn, aox2), array.remove(aoSlLn, aox2)
                            array.remove(aoLb, aox2), array.remove(aoTpLb, aox2), array.remove(aoSlLb, aox2)
                        aox2 -= 1
                label.delete(array.get(tAoTpLbl, i)), label.delete(array.get(tAoSlLbl, i))
                line.delete(array.get(tAoTpLn, i)),  line.delete(array.get(tAoSlLn, i))
                array.remove(tIsBuy, i), array.remove(tEntry, i), array.remove(tSL, i), array.remove(tTP, i)
                array.remove(tBarIdx, i), array.remove(tPipsDist, i), array.remove(tTradeRR, i), array.remove(tIsSmall, i), array.remove(tIsRec, i)
                array.remove(tIs2nd, i), array.remove(tIsAddon, i), array.remove(tTrailed, i), array.remove(tSlR, i), array.remove(tSlBox, i), array.remove(tTrailLn, i), array.remove(tSesRange, i), array.remove(tSesName, i)
                array.remove(tOriginTime, i), array.remove(tOrigEntry, i)
                array.remove(tAoTpLbl, i), array.remove(tAoSlLbl, i), array.remove(tAoTpLn, i), array.remove(tAoSlLn, i), array.remove(tAddonTPd, i)
// ==========================================

// --- 7. CLEANUP & STATS TABLE ---

// ==========================================

int targetMonthNum = statTargetM == "January" ? 1 : statTargetM == "February" ? 2 : statTargetM == "March" ? 3 : statTargetM == "April" ? 4 : statTargetM == "May" ? 5 : statTargetM == "June" ? 6 : statTargetM == "July" ? 7 : statTargetM == "August" ? 8 : statTargetM == "September" ? 9 : statTargetM == "October" ? 10 : statTargetM == "November" ? 11 : 12

int nDaysDraw   = math.min(statDays, array.size(dayList))

int cutoffDraw  = 0

if array.size(dayList) > 0
    cutoffDraw := array.get(dayList, array.size(dayList) - nDaysDraw)
// Anchor "current month" to the last bar on the chart (not wall-clock timenow),
// so the latest data month is always included and counted as the newest month.
int currentTotalM = year(time, tz) * 12 + month(time, tz)

f_cleanupDrawings() =>
    if array.size(regBoxes) > 0
        for i = array.size(regBoxes) - 1 to 0
            int bTime = array.get(regBoxTime, i)
            int bDayId = (year(bTime, tz) * 10000) + (month(bTime, tz) * 100) + dayofmonth(bTime, tz)
            bool keep = false
            if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
                keep := bDayId >= cutoffDraw
            else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
                keep := (year(bTime, tz) * 12 + month(bTime, tz)) >= (currentTotalM - statMonths + 1)
            else if statMode == "3. เจาะจงเดือนและปี (Specific Month)"
                keep := month(bTime, tz) == targetMonthNum and year(bTime, tz) == actualTargetY
            if not keep
                box.delete(array.get(regBoxes, i))
                array.remove(regBoxes, i), array.remove(regBoxTime, i)
    if array.size(regLines) > 0
        for i = array.size(regLines) - 1 to 0
            int lTime = array.get(regLineTime, i)
            int lDayId = (year(lTime, tz) * 10000) + (month(lTime, tz) * 100) + dayofmonth(lTime, tz)
            bool keep = false
            if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
                keep := lDayId >= cutoffDraw
            else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
                keep := (year(lTime, tz) * 12 + month(lTime, tz)) >= (currentTotalM - statMonths + 1)
            else if statMode == "3. เจาะจงเดือนและปี (Specific Month)"
                keep := month(lTime, tz) == targetMonthNum and year(lTime, tz) == actualTargetY
            if not keep
                line.delete(array.get(regLines, i))
                array.remove(regLines, i), array.remove(regLineTime, i)
    if array.size(regLabels) > 0
        for i = array.size(regLabels) - 1 to 0
            int lbTime = array.get(regLabelTime, i)
            int lbDayId = (year(lbTime, tz) * 10000) + (month(lbTime, tz) * 100) + dayofmonth(lbTime, tz)
            bool keep = false
            if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
                keep := lbDayId >= cutoffDraw
            else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
                keep := (year(lbTime, tz) * 12 + month(lbTime, tz)) >= (currentTotalM - statMonths + 1)
            else if statMode == "3. เจาะจงเดือนและปี (Specific Month)"
                keep := month(lbTime, tz) == targetMonthNum and year(lbTime, tz) == actualTargetY
            if not keep
                label.delete(array.get(regLabels, i))
                array.remove(regLabels, i), array.remove(regLabelTime, i)
// ==========================================

// --- LUXE TABLE THEME (โทนหรู: กระจกเข้ม + กรอบทอง + แถวสลับมีมิติ) ---

// ==========================================

color lxGold    = color.rgb(212, 175, 55)

color lxTitleTx = color.rgb(236, 210, 140)

color lxHeadBg  = color.new(color.rgb(26, 32, 52), 6)

color lxSubBg   = color.new(color.rgb(19, 24, 40), 8)

color lxColHd   = color.rgb(150, 160, 182)

color lxRowA    = color.new(color.rgb(13, 17, 28), 14)

color lxRowB    = color.new(color.rgb(22, 28, 46), 14)

color lxRowDim  = color.new(color.rgb(13, 17, 28), 52)

color lxText    = color.rgb(233, 236, 243)

color lxMuted   = color.rgb(128, 138, 158)

color lxDimTx   = color.rgb(90, 98, 116)

color lxGreen   = color.rgb(64, 216, 158)

color lxRed     = color.rgb(250, 118, 118)

color lxAmber   = color.rgb(251, 191, 36)

color lxCyan    = color.rgb(102, 208, 255)

color lxFrame   = color.new(lxGold, 42)

color lxGrid    = color.new(color.rgb(7, 10, 17), 35)

color lxBestBg  = color.new(lxGold, 84)

// แถบ winrate 10 ช่อง ▰▰▰▰▰▰▱▱▱▱

f_wrBar(float pct) =>
    string s = ""
    int filled = na(pct) ? 0 : math.min(10, math.max(0, math.round(pct / 10)))
    for _b = 1 to 10
        s += _b <= filled ? "▰" : "▱"
    s
f_monthShort(int m) =>
    switch m
        1  => "Jan"
        2  => "Feb"
        3  => "Mar"
        4  => "Apr"
        5  => "May"
        6  => "Jun"
        7  => "Jul"
        8  => "Aug"
        9  => "Sep"
        10 => "Oct"
        11 => "Nov"
        =>    "Dec"
var table statsTable        = table.new(f_tablePos(mainTablePosStr),    2, 15,              bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var table dailyStatsTable   = table.new(f_tablePos(dailyTablePosStr),   6, 34,              bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var table monthlyStatsTable = table.new(f_tablePos(monthlyTablePosStr), 5, statMonths + 3,  bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var table settingsTable     = table.new(f_tablePos(settingsTablePosStr),2, 30,              bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

// Merge-once flags stored in an array so the table-drawing functions can mutate them
// (Pine functions can mutate global arrays but cannot reassign global scalars)
var bool[] lxMergedArr = array.new_bool(6, false)

f_drawStats() =>
    int   winCnt  = 0
    int   lossCnt = 0
    int   streak     = 0
    int   maxW       = 0
    int   maxL       = 0
    int   curStreakStart = 0
    int   maxWStart  = 0
    int   maxWEnd    = 0
    int   maxLStart  = 0
    int   maxLEnd    = 0
    float netR       = 0.0
    float curWinSum  = 0.0
    float curLossSum = 0.0
    float maxWinR    = 0.0
    float maxLossR   = 0.0
    float curWinPips  = 0.0
    float curLossPips = 0.0
    float maxWinPips  = 0.0
    float maxLossPips = 0.0
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            int tDayId = (year(t, tz) * 10000) + (month(t, tz) * 100) + dayofmonth(t, tz)
            bool valid = false
            if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
                valid := tDayId >= cutoffDraw
            else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
                valid := (year(t, tz) * 12 + month(t, tz)) >= (currentTotalM - statMonths + 1)
            else if statMode == "3. เจาะจงเดือนและปี (Specific Month)"
                valid := month(t, tz) == targetMonthNum and year(t, tz) == actualTargetY
            if valid
                float tradeR = array.get(resTradeRR, i)
                bool  isWin  = array.get(resIsWin, i)
                float tPips  = array.get(resTpPts, i)
                netR += tradeR
                if streak == 0
                    curStreakStart := t
                if isWin
                    winCnt += 1
                    curWinSum  := streak >= 0 ? curWinSum + tradeR : tradeR
                    curWinPips := streak >= 0 ? curWinPips + tPips : tPips
                    if streak < 0
                        curStreakStart := t
                    streak     := streak >= 0 ? streak + 1 : 1
                    if streak > maxW
                        maxW      := streak
                        maxWStart := curStreakStart
                        maxWEnd   := t
                    maxWinR    := math.max(maxWinR, curWinSum)
                    maxWinPips := math.max(maxWinPips, curWinPips)
                else
                    lossCnt += 1
                    curLossSum  := streak <= 0 ? curLossSum + tradeR : tradeR
                    curLossPips := streak <= 0 ? curLossPips - tPips : -tPips
                    if streak > 0
                        curStreakStart := t
                    streak      := streak <= 0 ? streak - 1 : -1
                    if -streak > maxL
                        maxL      := -streak
                        maxLStart := curStreakStart
                        maxLEnd   := t
                    maxLossR    := math.min(maxLossR, curLossSum)
                    maxLossPips := math.min(maxLossPips, curLossPips)
    int   totalCnt  = winCnt + lossCnt
    float wr        = totalCnt > 0 ? (winCnt / totalCnt) * 100 : na
    color wrColor   = na(wr) ? lxMuted : wr >= 50 ? lxGreen : lxAmber
    color netRColor = totalCnt == 0 ? lxMuted : netR > 0 ? lxGreen : netR < 0 ? lxRed : lxAmber
    string netRStr  = totalCnt == 0 ? "-" : (netR > 0 ? "+" : "") + str.tostring(netR, "#.##") + "R"
    string streakStr   = streak > 0 ? "W" + str.tostring(streak) : streak < 0 ? "L" + str.tostring(-streak) : "-"
    color  streakColor = streak > 0 ? lxGreen : streak < 0 ? lxRed : lxMuted
    string periodStr = ""
    if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
        periodStr := "Last " + str.tostring(statDays) + " Days"
    else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
        periodStr := "Last " + str.tostring(statMonths) + " Months"
    else if statMode == "3. เจาะจงเดือนและปี (Specific Month)"
        periodStr := statTargetM + " " + str.tostring(actualTargetY)
    table.cell(statsTable, 0, 0,  "◆  PULLBACK PERFORMANCE", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(statsTable, 0, 1,  periodStr + "  ·  Base R:R 1:" + str.tostring(rrRatio, "#.#"), text_color=lxMuted, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(statsTable, 0, 2,  "Mode",       text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    string pbParamStr = str.tostring(pullbackRangePct, "#.#") + "% Rng"
    string modeStr    = switch entryMode
        "2. Pullback"              => "Pullback " + pbParamStr
        "3. Pullback + Re-break"   => "PB+Rebreak " + pbParamStr
        =>                            "Breakout"
    table.cell(statsTable, 1, 2,  modeStr, text_color=lxCyan, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 3,  "Trail SL",   text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 3,  useTrail ? str.tostring(trailTriggerR, "#.#") + "R → " + str.tostring(trailLockR, "#.#") + "R" : "OFF", text_color=useTrail ? lxAmber : lxMuted, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 4,  "Trades",     text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 4,  totalCnt == 0 ? "-" : str.tostring(winCnt) + "W · " + str.tostring(lossCnt) + "L", text_color=lxText, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 5,  "Winrate",    text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 5,  na(wr) ? "-" : str.tostring(wr, "#.#") + "%\\n" + f_wrBar(wr), text_color=wrColor, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 6,  "Net R",      text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 6,  netRStr,      text_color=netRColor, text_size=size.normal, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 7,  "Max Streak",   text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 7,  "W" + str.tostring(maxW) + " · L" + str.tostring(maxL), text_color=lxAmber, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    string maxWDateStr = maxW > 0 ? str.tostring(dayofmonth(maxWStart, tz)) + " " + f_monthShort(month(maxWStart, tz)) + " – " + str.tostring(dayofmonth(maxWEnd, tz)) + " " + f_monthShort(month(maxWEnd, tz)) : "-"
    string maxLDateStr = maxL > 0 ? str.tostring(dayofmonth(maxLStart, tz)) + " " + f_monthShort(month(maxLStart, tz)) + " – " + str.tostring(dayofmonth(maxLEnd, tz)) + " " + f_monthShort(month(maxLEnd, tz)) : "-"
    table.cell(statsTable, 0, 8,  " W" + str.tostring(maxW) + " Date", text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 8,  maxWDateStr, text_color=maxW > 0 ? lxGreen : lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 9,  " L" + str.tostring(maxL) + " Date", text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 9,  maxLDateStr, text_color=maxL > 0 ? lxRed : lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 10, "Max Streak R", text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 10, totalCnt == 0 ? "-" : "+" + str.tostring(maxWinR, "#.##") + "R · " + str.tostring(maxLossR, "#.##") + "R", text_color=lxAmber, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 11, "Max Streak P", text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 11, totalCnt == 0 ? "-" : "+" + str.tostring(maxWinPips, "#.#") + "p · " + str.tostring(maxLossPips, "#.#") + "p", text_color=lxAmber, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 12, "Streak",       text_color=lxMuted, text_size=size.tiny,  bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 12, streakStr,      text_color=streakColor, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 13, "Active",       text_color=lxDimTx, text_size=size.tiny,  bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 13, str.tostring(array.size(tEntry)), text_color=lxAmber, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_right)
    if not array.get(lxMergedArr, 1)
        array.set(lxMergedArr, 1, true)
        table.merge_cells(statsTable, 0, 0, 1, 0)
        table.merge_cells(statsTable, 0, 1, 1, 1)
// ==========================================

// --- ตารางที่ 3: DAILY WINRATE BY DATE (Specific Month) ---

// ==========================================

f_drawDaily() =>
    int[]    ddWin      = array.new_int(32, 0)
    int[]    ddLoss     = array.new_int(32, 0)
    float[]  ddNetR     = array.new_float(32, 0.0)
    float[]  ddWinPips  = array.new_float(32, 0.0)
    float[]  ddLossPips = array.new_float(32, 0.0)
    string[] ddTradeStr = array.new_string(32, "")
    if array.size(resIsWin) > 0
        for k = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, k)
            if month(t, tz) == targetMonthNum and year(t, tz) == actualTargetY
                int   d       = dayofmonth(t, tz)
                bool  isWin   = array.get(resIsWin,   k)
                float tradeR  = array.get(resTradeRR, k)
                bool  isSm    = array.get(resIsSmall, k)
                bool  isRec   = array.get(resIsRec,   k)
                bool  is2nd   = array.get(resIs2nd,   k)
                float tpPts   = array.get(resTpPts,   k)
                if d >= 1 and d <= 31
                    if isWin
                        array.set(ddWin,  d, array.get(ddWin,  d) + 1)
                        array.set(ddWinPips, d, array.get(ddWinPips, d) + tpPts)
                    else
                        array.set(ddLoss, d, array.get(ddLoss, d) + 1)
                        array.set(ddLossPips, d, array.get(ddLossPips, d) + tpPts)
                    array.set(ddNetR, d, array.get(ddNetR, d) + tradeR)
                    string rangePfx  = isSm ? "Sm·" : ""
                    string typeTag   = isRec ? "Reco" : is2nd ? "ออเดอร์ที่ 3" : "ออเดอร์ที่ 1"
                    string rSign     = tradeR >= 0 ? "+" : ""
                    string rStr      = rSign + str.tostring(tradeR, "#.##") + "R"
                    string tradeLine = isSm ? rangePfx + typeTag + " " + str.tostring(tpPts, "#.#") + "p " + rStr + "\\n" : rangePfx + typeTag + " " + rStr + "\\n"
                    array.set(ddTradeStr, d, array.get(ddTradeStr, d) + tradeLine)
    table.cell(dailyStatsTable, 0, 0, "◆  DAILY LOG  ·  " + statTargetM + " " + str.tostring(actualTargetY), text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 0, 1, "DATE",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 1, 1, "W-L",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 2, 1, "WR%",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 3, 1, "NET R",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 4, 1, "PIPS",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 5, 1, "TRADES", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int   totW = 0
    int   totL = 0
    float totR = 0.0
    float totWinPips  = 0.0
    float totLossPips = 0.0
    for d = 1 to 31
        int   dw   = array.get(ddWin,  d)
        int   dl   = array.get(ddLoss, d)
        float dnr  = array.get(ddNetR, d)
        float dwp  = array.get(ddWinPips,  d)
        float dlp  = array.get(ddLossPips, d)
        int   dtot = dw + dl
        float dwr  = dtot > 0 ? (dw / dtot) * 100.0 : na
        color dwrC = na(dwr) ? lxDimTx : dwr >= 50.0 ? lxGreen : lxAmber
        color dnrC = dtot == 0 ? lxDimTx : dnr > 0 ? lxGreen : dnr < 0 ? lxRed : lxAmber
        string dwlS   = dtot == 0 ? "-" : str.tostring(dw) + "W · " + str.tostring(dl) + "L"
        string dwrS   = na(dwr) ? "-" : str.tostring(dwr, "#.#") + "%"
        string dnrS   = dtot == 0 ? "-" : (dnr >= 0 ? "+" : "") + str.tostring(dnr, "#.##") + "R"
        string dpipS  = dtot == 0 ? "-" : "+" + str.tostring(dwp, "#.#") + " / -" + str.tostring(dlp, "#.#")
        color  dpipC  = dtot == 0 ? lxDimTx : (dwp - dlp) > 0 ? lxGreen : (dwp - dlp) < 0 ? lxRed : lxAmber
        string tradeS = array.get(ddTradeStr, d)
        if str.length(tradeS) > 0
            tradeS := str.substring(tradeS, 0, str.length(tradeS) - 1)
        color dayBg  = dtot == 0 ? lxRowDim : d % 2 == 1 ? lxRowA : lxRowB
        color dateC  = dtot == 0 ? lxDimTx : lxText
        table.cell(dailyStatsTable, 0, d + 1, str.tostring(d), text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 1, d + 1, dwlS,   text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 2, d + 1, dwrS,   text_color=dwrC,  text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 3, d + 1, dnrS,   text_color=dnrC,  text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTable, 4, d + 1, dpipS,  text_color=dpipC,  text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTable, 5, d + 1, tradeS, text_color=color.new(lxText, 22), text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_left)
        totW += dw
        totL += dl
        totR += dnr
        totWinPips  += dwp
        totLossPips += dlp
    int   totTot = totW + totL
    float totWR  = totTot > 0 ? (totW / totTot) * 100.0 : na
    color totWRC = na(totWR) ? lxDimTx : totWR >= 50 ? lxGreen : lxAmber
    color totNRC = totTot == 0 ? lxDimTx : totR > 0 ? lxGreen : totR < 0 ? lxRed : lxAmber
    string totWLS = totTot == 0 ? "-" : str.tostring(totW) + "W · " + str.tostring(totL) + "L"
    string totWRS = na(totWR) ? "-" : str.tostring(totWR, "#.#") + "%"
    string totNRS = totTot == 0 ? "-" : (totR >= 0 ? "+" : "") + str.tostring(totR, "#.##") + "R"
    string totPipS = totTot == 0 ? "-" : "+" + str.tostring(totWinPips, "#.#") + " / -" + str.tostring(totLossPips, "#.#")
    color  totPipC = totTot == 0 ? lxDimTx : (totWinPips - totLossPips) > 0 ? lxGreen : (totWinPips - totLossPips) < 0 ? lxRed : lxAmber
    table.cell(dailyStatsTable, 0, 33, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(dailyStatsTable, 1, 33, totWLS,  text_color=lxText,    text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 2, 33, totWRS,  text_color=totWRC,    text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 3, 33, totNRS,  text_color=totNRC,    text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTable, 4, 33, totPipS, text_color=totPipC,   text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTable, 5, 33, na(totWR) ? "" : f_wrBar(totWR), text_color=totWRC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    if not array.get(lxMergedArr, 3)
        array.set(lxMergedArr, 3, true)
        table.merge_cells(dailyStatsTable, 0, 0, 5, 0)
// ==========================================

// --- ตารางที่ 4: MONTHLY STATS (สรุปรายเดือน) ---

// ==========================================

f_drawMonthly() =>
    int startTotalM = currentTotalM - statMonths + 1
    int[] mWin    = array.new_int(statMonths, 0)
    int[] mLoss   = array.new_int(statMonths, 0)
    float[] mNetR = array.new_float(statMonths, 0.0)
    int[] mMaxW   = array.new_int(statMonths, 0)
    int[] mMaxL   = array.new_int(statMonths, 0)
    int[] mStreak = array.new_int(statMonths, 0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            int tTotalM = year(t, tz) * 12 + month(t, tz)
            int idx = tTotalM - startTotalM
            if idx >= 0 and idx < statMonths
                float tradeR = array.get(resTradeRR, i)
                bool isWin = array.get(resIsWin, i)
                int curStrk = array.get(mStreak, idx)
                if isWin
                    array.set(mWin, idx, array.get(mWin, idx) + 1)
                    curStrk := curStrk >= 0 ? curStrk + 1 : 1
                    array.set(mMaxW, idx, math.max(array.get(mMaxW, idx), curStrk))
                else
                    array.set(mLoss, idx, array.get(mLoss, idx) + 1)
                    curStrk := curStrk <= 0 ? curStrk - 1 : -1
                    array.set(mMaxL, idx, math.max(array.get(mMaxL, idx), -curStrk))
                array.set(mStreak, idx, curStrk)
                array.set(mNetR, idx, array.get(mNetR, idx) + tradeR)
    table.cell(monthlyStatsTable, 0, 0, "◆  MONTHLY  ·  Last " + str.tostring(statMonths) + " Months", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 0, 1, "MONTH",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 1, 1, "W-L",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 2, 1, "WR%",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 3, 1, "NET R",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 4, 1, "STREAK", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int bestMIdx = -1
    float bestMNR = 0.0
    for m = 0 to statMonths - 1
        if (array.get(mWin, m) + array.get(mLoss, m)) > 0 and array.get(mNetR, m) > bestMNR
            bestMNR := array.get(mNetR, m)
            bestMIdx := m
    int mSumW = 0
    int mSumL = 0
    float mSumR = 0.0
    for m = 0 to statMonths - 1
        int totalM = startTotalM + m
        int mMon = (totalM - 1) % 12 + 1
        int mYr  = math.round((totalM - mMon) / 12)
        string mLabel = f_monthShort(mMon) + " " + str.tostring(mYr)
        int mw = array.get(mWin, m)
        int ml = array.get(mLoss, m)
        float mnr = array.get(mNetR, m)
        int mtot = mw + ml
        float mwr = mtot > 0 ? (mw * 1.0 / mtot) * 100.0 : na
        color mwrC = na(mwr) ? lxDimTx : mwr >= 50 ? lxGreen : lxAmber
        color mnrC = mtot == 0 ? lxDimTx : mnr > 0 ? lxGreen : mnr < 0 ? lxRed : lxAmber
        string mwlS = mtot == 0 ? "-" : str.tostring(mw) + "W · " + str.tostring(ml) + "L"
        string mwrS = na(mwr) ? "-" : str.tostring(mwr, "#.#") + "%"
        string mnrS = mtot == 0 ? "-" : (mnr >= 0 ? "+" : "") + str.tostring(mnr, "#.##") + "R"
        bool isBestM = m == bestMIdx and mtot > 0
        color mRowBg = isBestM ? lxBestBg : m % 2 == 0 ? lxRowA : lxRowB
        color mLabelC = isBestM ? lxTitleTx : mtot == 0 ? lxDimTx : lxText
        int mmxW = array.get(mMaxW, m)
        int mmxL = array.get(mMaxL, m)
        string mStrkS = mtot == 0 ? "-" : "W" + str.tostring(mmxW) + " · L" + str.tostring(mmxL)
        table.cell(monthlyStatsTable, 0, m + 2, (isBestM ? "★ " : "") + mLabel, text_color=mLabelC, text_size=size.small, bgcolor=mRowBg, text_halign=text.align_left)
        table.cell(monthlyStatsTable, 1, m + 2, mwlS, text_color=mtot == 0 ? lxDimTx : lxText, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyStatsTable, 2, m + 2, mwrS, text_color=mwrC, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyStatsTable, 3, m + 2, mnrS, text_color=mnrC, text_size=size.small, bgcolor=mRowBg, text_halign=text.align_right)
        table.cell(monthlyStatsTable, 4, m + 2, mStrkS, text_color=mtot == 0 ? lxDimTx : lxAmber, text_size=size.small, bgcolor=mRowBg)
        mSumW += mw
        mSumL += ml
        mSumR += mnr
    int mSumTot = mSumW + mSumL
    float mSumWR = mSumTot > 0 ? (mSumW * 1.0 / mSumTot) * 100.0 : na
    color mSumWRC = na(mSumWR) ? lxDimTx : mSumWR >= 50 ? lxGreen : lxAmber
    color mSumNRC = mSumTot == 0 ? lxDimTx : mSumR > 0 ? lxGreen : mSumR < 0 ? lxRed : lxAmber
    string mSumWLS = mSumTot == 0 ? "-" : str.tostring(mSumW) + "W · " + str.tostring(mSumL) + "L"
    string mSumWRS = na(mSumWR) ? "-" : str.tostring(mSumWR, "#.#") + "%"
    string mSumNRS = mSumTot == 0 ? "-" : (mSumR >= 0 ? "+" : "") + str.tostring(mSumR, "#.##") + "R"
    int totalRow = statMonths + 2
    int allMaxW = 0
    int allMaxL = 0
    for sm = 0 to statMonths - 1
        allMaxW := math.max(allMaxW, array.get(mMaxW, sm))
        allMaxL := math.max(allMaxL, array.get(mMaxL, sm))
    string allStrkS = mSumTot == 0 ? "-" : "W" + str.tostring(allMaxW) + " · L" + str.tostring(allMaxL)
    table.cell(monthlyStatsTable, 0, totalRow, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(monthlyStatsTable, 1, totalRow, mSumWLS, text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 2, totalRow, mSumWRS, text_color=mSumWRC, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 3, totalRow, mSumNRS, text_color=mSumNRC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(monthlyStatsTable, 4, totalRow, allStrkS, text_color=mSumTot == 0 ? lxDimTx : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
    if not array.get(lxMergedArr, 4)
        array.set(lxMergedArr, 4, true)
        table.merge_cells(monthlyStatsTable, 0, 0, 4, 0)
// ==========================================

// --- ตารางที่ 5: SETTINGS SUMMARY (สรุปการตั้งค่าปัจจุบัน) ---

// ==========================================

f_drawSettings() =>
    table.clear(settingsTable, 0, 0, 1, 29)
    int rowIdx = 0
    // --- Title ---
    table.cell(settingsTable, 0, rowIdx, "◆  SETTINGS SUMMARY", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(settingsTable, 1, rowIdx, "",                    text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    rowIdx += 1
    // --- Build value strings ---
    string sMode = switch entryMode
        "2. Pullback"                => "Pullback"
        "3. Pullback + Re-break"     => "PB+Rebreak"
        =>                              "Breakout"
    string sPb = str.tostring(pullbackRangePct, "#.#") + "% Rng"
    string sEnabled = ""
    if useSyd
        sEnabled := "Syd"
    if useTok
        sEnabled := str.length(sEnabled) > 0 ? sEnabled + ", Tok" : "Tok"
    if useLon
        sEnabled := str.length(sEnabled) > 0 ? sEnabled + ", Lon" : "Lon"
    if useNy
        sEnabled := str.length(sEnabled) > 0 ? sEnabled + ", NY"  : "NY"
    if str.length(sEnabled) == 0
        sEnabled := "None"
    color rowBg = lxRowA
    // === Entry section (always) ===
    table.cell(settingsTable, 0, rowIdx, "─── Entry ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, "",              text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "Mode", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, sMode, text_color=lxCyan,   text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    if usePbLevel
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        table.cell(settingsTable, 0, rowIdx, "Pullback", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, sPb,        text_color=lxText,  text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    if planExpireHours > 0
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        table.cell(settingsTable, 0, rowIdx, "Plan Expire", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, str.tostring(planExpireHours, "#.#") + "h", text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    if not closeMainOnNewSes
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        table.cell(settingsTable, 0, rowIdx, "Close on NewSes", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, "OFF",              text_color=lxRed,   text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    if use2ndOrder
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        string sndDisp = use2ndCustomRR ? "ON · " + str.tostring(secondRR, "#.#") + "R" : "ON"
        table.cell(settingsTable, 0, rowIdx, "2nd Order", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, sndDisp,     text_color=lxGreen, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    if useAddOn50
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        string aoTpDisp = aoTpMode == "R:R Ratio" ? str.tostring(aoRR, "#.#") + "R" : "Box"
        table.cell(settingsTable, 0, rowIdx, "50% Add-on", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, "ON · TP " + aoTpDisp, text_color=lxGreen, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
        if aoMainBE
            rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
            table.cell(settingsTable, 0, rowIdx, " └ Main → BE", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
            table.cell(settingsTable, 1, rowIdx, "ON",            text_color=lxGreen, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
            rowIdx += 1
    // === Sessions section (always) ===
    table.cell(settingsTable, 0, rowIdx, "─── Sessions ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, "",                 text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "Enabled", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, sEnabled,  text_color=lxText,  text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    // === Risk section (always) ===
    table.cell(settingsTable, 0, rowIdx, "─── Risk ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, "",             text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    string sOneRTxt = oneRBasis == "ATR" ? ("ATR " + str.tostring(oneRAtrMult, "#.#") + "x") : (oneRBasis == "Distance" ? ("Dist " + str.tostring(oneRDistFix, "#.###")) : (str.tostring(oneRPctVal, "#.#") + "% Sess"))
    color  sOneRCol = oneRBasis == "ATR" ? color.new(color.purple, 0) : (oneRBasis == "Distance" ? lxAmber : lxText)
    table.cell(settingsTable, 0, rowIdx, "1R Basis",    text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, sOneRTxt,      text_color=sOneRCol, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    if slEdgeMode
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        table.cell(settingsTable, 0, rowIdx, "SL Place", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, "Edge",     text_color=lxGreen, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
    table.cell(settingsTable, 0, rowIdx, "Risk / R:R", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
    table.cell(settingsTable, 1, rowIdx, "$" + str.tostring(riskAmount, "#") + " · 1:" + str.tostring(rrRatio, "#.#"), text_color=lxText, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
    rowIdx += 1
    if rrBaseMode == "SL Distance"
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        table.cell(settingsTable, 0, rowIdx, "R:R Base", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, "SL Dist",  text_color=lxCyan,  text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    if spreadPts > 0
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        table.cell(settingsTable, 0, rowIdx, "Spread", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, str.tostring(spreadPts, "#.#####"), text_color=lxAmber, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    // === Add-ons section (if any) ===
    if useTrail
        table.cell(settingsTable, 0, rowIdx, "─── Add-ons ───", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, "",                text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
        rowIdx += 1
        rowBg := rowIdx % 2 == 1 ? lxRowA : lxRowB
        table.cell(settingsTable, 0, rowIdx, "Trail SL", text_color=lxMuted, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(settingsTable, 1, rowIdx, str.tostring(trailTriggerR, "#.#") + "R→" + str.tostring(trailLockR, "#.#") + "R", text_color=lxAmber, text_size=size.tiny, bgcolor=rowBg, text_halign=text.align_right)
        rowIdx += 1
    // --- Merge title (once) ---
    if not array.get(lxMergedArr, 5)
        array.set(lxMergedArr, 5, true)
        table.merge_cells(settingsTable, 0, 0, 1, 0)

// ==========================================

// --- 8. DRAW CALLS (stats/tables wrapped in functions to keep main body short) ---

// ==========================================

if limitDrawDays and barstate.islast
    f_cleanupDrawings()

if showStatsTable and barstate.islast
    f_drawStats()

if showDailyTable and barstate.islast
    f_drawDaily()

if showMonthlyTable and barstate.islast and statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
    f_drawMonthly()

if showSettingsTable and barstate.islast
    f_drawSettings()
