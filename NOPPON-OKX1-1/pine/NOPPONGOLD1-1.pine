//@version=6

indicator("NOPPON-GOLD1-1", shorttitle="NPN-GOLD1-1", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==========================================

// --- 1. INPUT SETTINGS ---

// ==========================================

// --- Entry Strategy ---

entryModeTip = "คำอธิบายแต่ละโหมด:\\n\\n1. Breakout — ราคาเบรคขอบกรอบ → เข้าที่ขอบทันที (เร็ว แต่โดนเบรคหลอกง่าย)\\n\\n2. Pullback — เบรค → รอย่อลึกตาม % → เข้าที่ราคาย่อ (R:R ดีขึ้น อาจพลาด trade)\\n\\n3. Pullback + Re-break — เบรค → รอย่อ → รอเบรคขอบอีกครั้ง → เข้าที่ขอบ (ยืนยัน 3 ชั้น)"

entryMode        = input.string("1. Breakout", title="Entry Mode", options=["1. Breakout", "2. Pullback", "3. Pullback + Re-break"], group="Entry Strategy", tooltip=entryModeTip)

pullbackRangePct = input.float(20, title=" Pullback % of Range (โหมด 2, 3)", minval=1, maxval=100, step=5, group="Entry Strategy")

usePullback      = entryMode == "2. Pullback" or entryMode == "3. Pullback + Re-break"

usePbRebreak     = entryMode == "3. Pullback + Re-break"

usePbLevel       = usePullback

planExpireHours  = input.float(0, title="Plan Expiry (hrs, 0=cancel at session start)", minval=0, step=0.5, group="Entry Strategy")

closeMainOnNewSes = input.bool(true, title="Close Main Order on New Session (ปิด Main order เมื่อเซสชั่นใหม่เริ่ม)", group="Entry Strategy")

use2ndOrder       = input.bool(true, title="Enable 2nd Order on Re-break (เปิด order ใหม่เมื่อเบรคกรอบเดิมอีก)", group="Entry Strategy")

use2ndCustomRR    = input.bool(false, title=" └ 2nd Order: Custom TP R:R (ตั้ง R:R ของไม้ 2 อิสระ)", group="Entry Strategy", tooltip="ปิด = ไม้ 2 ใช้ R:R เดียวกับ Base R:R\\nเปิด = ไม้ 2 ใช้ค่า R:R ด้านล่างแทน")

secondRR          = input.float(5, title=" └ 2nd Order R:R", minval=0.1, step=0.1, group="Entry Strategy", tooltip="R:R ของไม้ 2 เมื่อเปิด Custom TP R:R")

useAddOn50        = input.bool(true, title="Enable 50% Add-on Order (main ยังเปิด + ราคาย่อกลับ 50% กรอบ → เปิดไม้เสริม)", group="Entry Strategy", tooltip="เมื่อ main order ยังเปิดอยู่ แล้วราคาย่อกลับมาที่ 50% ของกรอบ session → เปิดไม้เสริม (Add-on)")

aoTpMode          = input.string("R:R Ratio", title=" └ Add-on TP Mode", options=["ราคาทุน Main", "R:R Ratio"], group="Entry Strategy", tooltip="ราคาทุน Main = TP ที่ขอบกรอบ (entry ของ main)\\nR:R Ratio = TP ตาม R:R อิสระ คำนวณจาก 1R ของ add-on")

aoRR              = input.float(5, title=" └ Add-on R:R", minval=0.1, step=0.1, group="Entry Strategy", tooltip="R:R สำหรับ Add-on เมื่อเลือก TP Mode = R:R Ratio\\n1R = ระยะ entry ถึง SL")

aoMainBE          = input.bool(false, title=" └ Move Main TP to Break-even (ย้าย TP main มาเท่าทุนเมื่อเปิดไม้เสริม)", group="Entry Strategy", tooltip="เมื่อ Add-on 50% เปิด → ย้าย TP ของ main มาที่ราคา entry (ขอบกรอบ)")

aoKeepOpen        = input.bool(false, title=" └ Add-on: Don't Close with Main on New Session", group="Entry Strategy", tooltip="ปิด = add-on ถูกปิดพร้อม main เมื่อเซสชั่นใหม่เริ่ม\\nเปิด = add-on ยังเปิดต่อ รอ TP/SL ของตัวเอง")

tradeSun          = input.bool(false, title="Trade Sunday",    group="Entry Strategy")
tradeMon          = input.bool(true,  title="Trade Monday",    group="Entry Strategy")
tradeTue          = input.bool(true,  title="Trade Tuesday",   group="Entry Strategy")
tradeWed          = input.bool(true,  title="Trade Wednesday", group="Entry Strategy")
tradeThu          = input.bool(true,  title="Trade Thursday",  group="Entry Strategy")
tradeFri          = input.bool(true,  title="Trade Friday",    group="Entry Strategy")
tradeSat          = input.bool(false, title="Trade Saturday",  group="Entry Strategy")

// --- Session ---

sesRefTip = "REFERENCE — เวลาเริ่มตลาด (UTC) ตามฤดู\\n(ใช้เป็น anchor ตั้งค่าช่อง Session เอง)\\n\\n━ Forex Session Open (07:00 ท้องถิ่น) ━\\n • Sydney:   Oct-Mar 2000  /  Apr-Sep 2100\\n • Tokyo:    ทั้งปี 0000\\n • London:   Oct-Mar 0800  /  Apr-Sep 0700\\n • New York: Oct-Mar 1300  /  Apr-Sep 1200\\n\\n━ Gold / CME Reset (18:00 NY = แท่งแรกหลัง daily break) ━\\n • Oct-Mar (EST): 2300\\n • Apr-Sep (EDT): 2200\\n\\n━ Daily Market Break (ตลาดปิด) ━\\n • Gold: Oct-Mar 2200-2300  /  Apr-Sep 2100-2200\\n\\nหมายเหตุ:\\n • US DST จริง = กลาง มี.ค. → ต้น พ.ย.\\n   โค้ดใช้ Apr-Sep เป็นเกณฑ์ → คลาดเคลื่อน ~2 สัปดาห์ที่ขอบ\\n • Sydney ซีกโลกใต้ → DST สลับกับซีกเหนือ\\n   (ช่วง Oct-Mar ซิดนีย์อยู่ในหน้าร้อน/DST)"

useSyd    = input.bool(true, title="Enable Sydney", group="Session", tooltip=sesRefTip)

sydSes    = input.session("2000-0500", title=" Sydney Time (Oct-Mar)", group="Session", tooltip=sesRefTip)

sydSesDst = input.session("2100-0600", title=" Sydney Time (Apr-Sep)", group="Session", tooltip=sesRefTip)

sydCol    = input.color(color.blue, title=" Sydney Box Color", group="Session")

useTok    = input.bool(false, title="Enable Tokyo", group="Session")

tokSes    = input.session("0000-0900", title=" Tokyo Time (Oct-Mar)", group="Session", tooltip=sesRefTip)

tokSesDst = input.session("0000-0900", title=" Tokyo Time (Apr-Sep)", group="Session", tooltip=sesRefTip)

tokCol    = input.color(color.fuchsia, title=" Tokyo Box Color", group="Session")

useLon    = input.bool(false, title="Enable London", group="Session")

lonSes    = input.session("0800-1700", title=" London Time (Oct-Mar)", group="Session", tooltip=sesRefTip)

lonSesDst = input.session("0700-1600", title=" London Time (Apr-Sep)", group="Session", tooltip=sesRefTip)

lonCol    = input.color(color.green, title=" London Box Color", group="Session")

useNy     = input.bool(false, title="Enable New York", group="Session")

nySes     = input.session("1300-2200", title=" New York Time (Oct-Mar)", group="Session", tooltip=sesRefTip)

nySesDst  = input.session("1200-2100", title=" New York Time (Apr-Sep)", group="Session", tooltip=sesRefTip)

nyCol     = input.color(color.orange, title=" New York Box Color", group="Session")

// V9.7: Gap Fallback — เมื่อ session ตกอยู่ในช่วงที่ตลาดปิด (daily break/สุดสัปดาห์)

gapFallback = input.bool(false, title="Gap Fallback (session ตกช่วงตลาดปิด → ใช้แท่งแรกหลังตลาดเปิด)", group="Session", tooltip="บางสินทรัพย์มีช่วงพักตลาดรายวัน\\nเปิด = ใช้แท่งแรกหลังตลาดกลับมาเปิดเป็นกรอบ session แทน\\nปิด = ข้าม session นั้นและแสดง warning บนกราฟ")

tz_incr      = input.int(0, title="UTC (+/-)", group="Timezone")

use_exchange = input.bool(false, title=" Timezone Exchange", group="Timezone")

// --- Risk Management ---

// 1R Basis: เลือกฐานคำนวณ 1R (Risk Unit) ที่ใช้ทั้ง TP, R:R, และ lot sizing

oneRBasis     = input.string("SL%", title="1R Basis", options=["SL%", "Distance", "ATR"], group="Risk Management", tooltip="เลือกฐานคำนวณ 1R ที่ใช้ทั้ง TP, R:R, และ lot sizing\\n\\nSL% = 1R เท่ากับ % ของ session range\\nDistance = 1R เท่ากับระยะห่างคงที่\\nATR = 1R เท่ากับ ATR × Multiplier")

oneRPctVal    = input.float(55, title=" [SL%] 1R = % of Session", minval=1, maxval=100, step=5, group="Risk Management", tooltip="ใช้เมื่อ 1R Basis = SL%\\n1R = % ที่กรอก × session range")

oneRDistFix   = input.float(5, title=" [Distance] 1R = Fixed Distance", minval=0.001, step=1, group="Risk Management", tooltip="ใช้เมื่อ 1R Basis = Distance\\n1R = ระยะห่างคงที่ (หน่วยราคาของสินทรัพย์)")

oneRAtrPeriod = input.int(14, title=" [ATR] Period", minval=5, maxval=50, group="Risk Management", tooltip="ใช้เมื่อ 1R Basis = ATR")

oneRAtrMult   = input.float(1.5, title=" [ATR] Multiplier", minval=0.5, maxval=5, step=0.1, group="Risk Management", tooltip="1R = ATR(period) × Multiplier")

slEdgeMode    = input.bool(false, title="SL at Session Edge (SL วางที่ขอบกรอบ)", group="Risk Management", tooltip="เปิด = SL วางที่ขอบ session เสมอ\\n1R Basis ยังใช้เป็นไม้บรรทัดสำหรับ TP และ R accounting")

riskAmount    = input.float(500.0, title=" Risk per 1R ($)", minval=0.01, group="Risk Management", tooltip="เงินที่ยอมเสียต่อ 1R\\nlot ถูก size ให้ hitting 1R = ขาดทุนเท่านี้\\nถ้าเปิด Edge SL → ขาดทุนจริงเมื่อโดน SL = R × Risk (อาจมากกว่า)")

rrRatio       = input.float(5.0, title=" Risk : Reward (R:R)", minval=0.1, step=0.1, group="Risk Management")

rrBaseMode    = input.string("SL Distance", title=" R:R Measured Against", options=["1R Basis", "SL Distance"], group="Risk Management", tooltip="ฐานที่ใช้คูณกับ R:R เพื่อหาระยะ TP\\n\\n1R Basis = TP = entry ± (1R × R:R)\\nSL Distance = TP = entry ± (ระยะ SL จริง × R:R)")

pipValueRatio = input.float(100.0, title=" 1 Lot Ratio", group="Risk Management")

spreadPts     = input.float(0, title=" Spread (price)", minval=0, step=0.0001, group="Risk Management", tooltip="Spread ของโบรคเกอร์ (หน่วยราคา)\\nBUY: entry = ขอบกรอบ + spread\\nSELL: entry = ขอบกรอบ - spread")

// 1R distance base values (session-range mode still needs sesRange to compute at runtime)

float atrVal   = ta.atr(oneRAtrPeriod)

float oneRAtr  = atrVal * oneRAtrMult

float oneRPct     = oneRPctVal / 100

// --- Trailing SL (Normal) ---

useTrail      = input.bool(false, title="Enable Trailing SL (Normal)", group="Trailing SL (Normal)")

trailTriggerR = input.float(2.0, title="Trail Trigger at (R)", minval=0.1, step=0.1, group="Trailing SL (Normal)")

trailLockR    = input.float(1.0, title="Lock SL at (R)", minval=0.0, step=0.1, group="Trailing SL (Normal)")

// --- Display & Stats ---

showSesRange   = input.bool(false, title=" Show Session Boxes", group="Display & Stats")

showStatsTable = input.bool(true, title=" Show Stats Table", group="Display & Stats")

showTradePath  = input.bool(true, title=" Show Trade Path Lines (เส้นโยงจากเปิด→TP/SL)", group="Display & Stats")

showTpSlBox    = false  // TP/SL boxes removed — arrows used instead

showDailyTable   = input.bool(false, title=" Show Daily Stats Table (Winrate รายวันของเดือน)", group="Display & Stats")

showMonthlyTable = input.bool(true, title=" Show Monthly Stats Table (สรุปรายเดือน)", group="Display & Stats")

showSettingsTable = input.bool(false, title=" Show Settings Summary Table (สรุปการตั้งค่า)", group="Display & Stats")

limitDrawDays    = input.bool(true, title=" Limit Drawings", group="Display & Stats")

statMode       = input.string("2. ย้อนหลังตามจำนวนเดือน (Months)", title="▶ เลือกโหมดดูสถิติ (Dropdown)", options=["1. ย้อนหลังตามจำนวนวัน (Days)", "2. ย้อนหลังตามจำนวนเดือน (Months)", "3. เจาะจงเดือนและปี (Specific Month)"], group="Display & Stats")

statDays       = input.int(1, title="[โหมด 1] ย้อนหลัง (วัน)", minval=1, maxval=365, group="Display & Stats")

statMonths     = input.int(9, title="[โหมด 2] ย้อนหลัง (เดือน) [1-12]", minval=1, maxval=12, group="Display & Stats")

statTargetM    = input.string("August", title="[โหมด 3] ระบุเดือน", options=["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"], group="Display & Stats")

statTargetY    = input.int(0, title="[โหมด 3] ระบุปี (ใส่ 0 = ดึงปีปัจจุบันอัตโนมัติ)", minval=0, maxval=2100, group="Display & Stats")

// --- Table Position ---

// เรียงซ้าย→ขวา ตามความสูง (สูง→เตี้ย): dailyStats(34) | monthlyStats(~15) | stats(11) | dayStats(8)

// หมายเหตุ: PineScript มี bottom slot เพียง 3 (Left/Center/Right), ตัวเตี้ยสุดวางที่ Middle Right

settingsTablePosStr = input.string("Bottom Left",  title="▶ ตำแหน่งตาราง Settings Summary",    options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display & Stats")

dailyTablePosStr   = input.string("Middle Left",   title="▶ ตำแหน่งตาราง Daily (By Date)",    options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display & Stats")

monthlyTablePosStr = input.string("Bottom Center", title="▶ ตำแหน่งตาราง Monthly (By Month)", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display & Stats")

mainTablePosStr    = input.string("Bottom Right",  title="▶ ตำแหน่งตารางหลัก (Stats)",       options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display & Stats")

orderLabelSizeStr  = input.string("Small", title="Order Label Size (ขนาดป้าย Buy/Sell/Add-on)", options=["Tiny","Small","Normal","Large","Huge"], group="Display & Stats")

orderLabelSize = orderLabelSizeStr == "Tiny" ? size.tiny : orderLabelSizeStr == "Normal" ? size.normal : orderLabelSizeStr == "Large" ? size.large : orderLabelSizeStr == "Huge" ? size.huge : size.small

// small price/level labels scale one step below the main order labels
orderLabelSizeSm = orderLabelSizeStr == "Tiny" ? size.tiny : orderLabelSizeStr == "Small" ? size.small : orderLabelSizeStr == "Normal" ? size.small : orderLabelSizeStr == "Large" ? size.normal : size.large

// ==========================================

// --- 2. TIMEZONE & UTILS ---

// ==========================================

tf = timeframe.period

var tz = use_exchange ? syminfo.timezone : str.format("UTC{0}{1}", tz_incr >= 0 ? "+" : "-", math.abs(tz_incr))

// --- Helper: แปลง string → table position ---

f_tablePos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.bottom_right
int currentYear = year(timenow, tz)

int actualTargetY = statTargetY == 0 ? currentYear : statTargetY

var array<bool>  resIsWin   = array.new_bool()

var array<float> resTradeRR = array.new_float()

var array<int>   resTime    = array.new_int()

var array<bool>  resIsSmall = array.new_bool()

var array<bool>  resIsRec   = array.new_bool()

var array<bool>  resIs2nd   = array.new_bool()

var array<float> resTpPts   = array.new_float()

var array<int>   dayList    = array.new_int()

int curDayId = (year(time, tz) * 10000) + (month(time, tz) * 100) + dayofmonth(time, tz)

bool needPushDay = array.size(dayList) == 0

if not needPushDay
    needPushDay := array.get(dayList, array.size(dayList) - 1) != curDayId
if needPushDay
    array.push(dayList, curDayId)
    if array.size(dayList) > 400
        array.shift(dayList)
var array<box>   regBoxes    = array.new<box>()

var array<int>   regBoxTime  = array.new_int()

var array<line>  regLines    = array.new<line>()

var array<int>   regLineTime = array.new_int()

var array<label> regLabels   = array.new<label>()

var array<int>   regLabelTime= array.new_int()

regBox(box _b) =>
    if not na(_b)
        array.push(regBoxes, _b)
        array.push(regBoxTime, time)
        if array.size(regBoxes) > 600
            box.delete(array.shift(regBoxes))
            array.shift(regBoxTime)
regLine(line _l) =>
    if not na(_l)
        array.push(regLines, _l)
        array.push(regLineTime, time)
        if array.size(regLines) > 600
            line.delete(array.shift(regLines))
            array.shift(regLineTime)
regLabel(label _lb) =>
    if not na(_lb)
        array.push(regLabels, _lb)
        array.push(regLabelTime, time)
        if array.size(regLabels) > 600
            label.delete(array.shift(regLabels))
            array.shift(regLabelTime)
// ==========================================

// --- 3. SESSION & TRADE DATA STRUCTURES ---

// ==========================================

type SessionData
    string name
    string timeStr
    string dstTimeStr
    bool   isEnabled
    bool   isActive
    float  hi
    float  lo
    int    startBar
    box    rangeBox
    color  boxCol
var array<SessionData> sessions = array.new<SessionData>()

if barstate.isfirst
    array.push(sessions, SessionData.new("Sydney", sydSes, sydSesDst, useSyd, false, na, na, na, na, sydCol))
    array.push(sessions, SessionData.new("Tokyo", tokSes, tokSesDst, useTok, false, na, na, na, na, tokCol))
    array.push(sessions, SessionData.new("London", lonSes, lonSesDst, useLon, false, na, na, na, na, lonCol))
    array.push(sessions, SessionData.new("New York", nySes, nySesDst, useNy, false, na, na, na, na, nyCol))
// --- Plan arrays ---

var array<int>    pOcoId    = array.new_int()

var array<string> pSesName  = array.new_string()

var array<bool>   pIsBuy    = array.new_bool()

var array<float>  pEntry    = array.new_float()

var array<float>  pSL       = array.new_float()

var array<float>  pTP       = array.new_float()

var array<float>  pLot      = array.new_float()

var array<float>  pTradeRR  = array.new_float()

var array<bool>   pIsSmall  = array.new_bool() 

var array<float>  pSesRange = array.new_float()

var array<box>    pTpBox    = array.new_box()

var array<box>    pSlBox    = array.new_box()

var array<line>   pLine     = array.new_line()

var array<line>   pTpLn     = array.new_line()

var array<line>   pSlLn     = array.new_line()

var array<label>  pTpLbl    = array.new_label()

var array<label>  pSlLbl    = array.new_label()

var array<label>  pLabel    = array.new_label()

var array<int>    pState      = array.new_int()

var array<int>    pCreateTime = array.new_int()

var int ocoCounter = 0

// --- Trade arrays ---

var array<bool>   tIsBuy    = array.new_bool()

var array<float>  tEntry    = array.new_float()

var array<float>  tSL       = array.new_float()

var array<float>  tTP       = array.new_float()

var array<int>    tBarIdx   = array.new_int()

var array<float>  tPipsDist = array.new_float()

var array<float>  tTradeRR  = array.new_float() 

var array<bool>   tIsSmall  = array.new_bool() 

var array<bool>   tIsRec    = array.new_bool()

var array<bool>   tTrailed  = array.new_bool()

var array<float>  tSlR      = array.new_float()

var array<box>    tSlBox    = array.new_box()

var array<line>   tTrailLn  = array.new_line()

// per-trade TP/SL fill visuals — TP/SL price tags + horizontal level lines
// Every trade (Main, 2nd, Add-on) captures its handles; all four are deleted at trade close
// so the level markers vanish with the order instead of lingering as chart clutter.

var array<label>  tAoTpLbl  = array.new_label()

var array<label>  tAoSlLbl  = array.new_label()

var array<line>   tAoTpLn   = array.new_line()

var array<line>   tAoSlLn   = array.new_line()

// Per-Main flag: was this Main's linked Add-on already closed with a TP win?
// If true, don't arm the 2nd-order rescue when this Main hits SL — the pair already recovered.

var array<bool>   tAddonTPd = array.new_bool()

var array<float>  tSesRange    = array.new_float()

var array<string> tSesName     = array.new_string()

var array<int>    tOriginTime  = array.new_int()

var array<float>  tOrigEntry   = array.new_float()

var array<bool>   tIs2nd       = array.new_bool()

var array<bool>   tIsAddon     = array.new_bool()

// --- 2nd Order Pending arrays ---

var array<bool>   p2IsBuy      = array.new_bool()

var array<float>  p2Entry      = array.new_float()

var array<float>  p2SesRange   = array.new_float()

var array<string> p2SesName    = array.new_string()

var array<int>    p2OriginTime = array.new_int()

var array<bool>   p2IsSmall    = array.new_bool()

var array<float>  p2OrigEntry  = array.new_float()

var array<line>   p2PendLn     = array.new_line()      // pending re-break level line (shown from the main SL)

var array<label>  p2PendLb     = array.new_label()     // pending "Ready to Trade" label (shown from the main SL)

var array<line>   p2PendTpLn   = array.new_line()      // pending TP level line for the 2nd order preview

var array<line>   p2PendSlLn   = array.new_line()      // pending SL level line for the 2nd order preview

var array<label>  p2PendTpLb   = array.new_label()     // pending TP price tag for the 2nd order preview

var array<label>  p2PendSlLb   = array.new_label()     // pending SL price tag for the 2nd order preview

// --- 50% Add-on Order Pending arrays ---

var array<bool>   aoIsBuy      = array.new_bool()

var array<float>  aoLevel      = array.new_float()   // 50% trigger price

var array<float>  aoTP         = array.new_float()   // main entry (cost) = TP target

var array<float>  aoSL         = array.new_float()   // main SL snapshot

var array<float>  aoSesRange   = array.new_float()

var array<string> aoSesName    = array.new_string()

var array<int>    aoOriginTime = array.new_int()     // main's origin time (link key)

var array<bool>   aoIsSmall    = array.new_bool()

var array<line>   aoLn         = array.new_line()      // moving purple dashed line at the 50% entry level

var array<line>   aoTpLn       = array.new_line()      // add-on TP purple dashed line

var array<line>   aoSlLn       = array.new_line()      // add-on SL purple dashed line

var array<label>  aoLb         = array.new_label()     // add-on preview main label ("ออเดอร์ที่ 2 รอ ...")

var array<label>  aoTpLb       = array.new_label()     // add-on preview TP price tag

var array<label>  aoSlLb       = array.new_label()     // add-on preview SL price tag

// ==========================================

// --- 4. SESSION TRACKING & PLAN CREATION ---

// ==========================================

// Unified 1R distance helper — pass session range for SL% mode

oneRDistOf(float sesRng) => oneRBasis == "Distance" ? oneRDistFix : oneRBasis == "ATR" ? oneRAtr : sesRng * oneRPct

// V9.6: Manual session-overlap detector.

// Pine's built-in time(tf, session) checks only if the bar OPEN falls inside

// the session — which silently misses sub-hour sessions on higher chart TFs

// (e.g. session "2100-2115" on a 4H chart, since no bar opens at 21:00).

// This helper checks bar-vs-session OVERLAP so any bar whose time window

// touches the session counts as in-session, on any chart TF.

inSessionOverlap(string sesStr) =>
    int sStart = 0
    int sEnd   = 0
    bool ok = false
    if str.length(sesStr) >= 9
        int sH1 = int(str.tonumber(str.substring(sesStr, 0, 2)))
        int sM1 = int(str.tonumber(str.substring(sesStr, 2, 4)))
        int sH2 = int(str.tonumber(str.substring(sesStr, 5, 7)))
        int sM2 = int(str.tonumber(str.substring(sesStr, 7, 9)))
        sStart := sH1 * 60 + sM1
        sEnd   := sH2 * 60 + sM2
        int barMin = hour(time, tz) * 60 + minute(time, tz)
        int barLen = math.max(1, math.round(timeframe.in_seconds() / 60))
        int barEnd = barMin + barLen
        if sStart < sEnd
            // Same-day session
            ok := barMin < sEnd and barEnd > sStart
        else if sStart > sEnd
            // Crosses midnight → [sStart, 1440) ∪ [0, sEnd)
            ok := barMin >= sStart or barMin < sEnd or barEnd > sStart or (barEnd > 1440 and (barEnd - 1440) > 0)
    ok
// V9.7: timestamp (ms) ของเวลาเริ่ม session บนวันที่ของแท่งปัจจุบัน

sesStartTsOf(string sesStr) =>
    int h = int(str.tonumber(str.substring(sesStr, 0, 2)))
    int m = int(str.tonumber(str.substring(sesStr, 2, 4)))
    timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), h, m, 0)
int curMonth = month(time, tz)

bool isDST = curMonth >= 4 and curMonth <= 9

// --- Alert event flags (bar-level; reset each bar, set true when the event fires) ---
bool sigNewOrder = false
bool sigFilled   = false
bool sig2ndOpen  = false
bool sigAddOn    = false

for i = 0 to array.size(sessions) - 1
    SessionData s = array.get(sessions, i)
    bool trackThis = s.isEnabled
    string cancelMatchName = s.name
    if trackThis
        string activeSes = isDST ? s.dstTimeStr : s.timeStr
        bool is_ses = inSessionOverlap(activeSes)
        // V9.7: Gap-swallowed session — ทั้ง session window ตกอยู่ในช่องว่างของข้อมูล
        // (ตลาดพักรายวัน เช่น XAUUSD 21:00-22:00 UTC หน้าร้อนสหรัฐ) → ไม่มีแท่งไหน
        // overlap กับ session เลยบน TF นี้ ตรวจจับด้วย: แท่งนี้เปิดหลัง session start,
        // แท่งก่อนหน้าจบก่อน session start (มี gap คร่อม), และช้าไม่เกิน 4 ชม.
        bool gapMissed = false
        if not is_ses and not s.isActive
            int gTs = sesStartTsOf(activeSes)
            int barLenMs = timeframe.in_seconds() * 1000
            bool swallowed = time > gTs and nz(time[1]) + barLenMs <= gTs and (time - gTs) <= 4 * 3600 * 1000
            if swallowed
                if gapFallback
                    gapMissed := true
                    regLabel(label.new(x=bar_index, y=high, text="⏩ Gap Fallback", style=label.style_label_down, color=color.new(color.orange, 40), textcolor=color.white, size=size.small))
                else
                    regLabel(label.new(x=bar_index, y=high, text="⚠ Missed\\nตลาดปิดช่วง session", style=label.style_label_down, color=color.new(color.red, 30), textcolor=color.white, size=size.small))
        bool sesStart = (is_ses or gapMissed) and not s.isActive
        bool sesEnd   = not is_ses and s.isActive
        s.isActive := is_ses or gapMissed
        if sesStart
            if planExpireHours == 0 and array.size(pSesName) > 0
                int pIdx = array.size(pSesName) - 1
                while pIdx >= 0
                    if pIdx < array.size(pSesName) and array.get(pSesName, pIdx) == cancelMatchName
                        bool  isBCancel = array.get(pIsBuy, pIdx)
                        float cancelY   = array.get(pEntry, pIdx)
                        regLabel(label.new(x=bar_index, y=cancelY, text="Cancel", color=color.new(color.gray, 20), textcolor=color.white, style=isBCancel ? label.style_label_down : label.style_label_up, size=orderLabelSize))
                        box.delete(array.get(pTpBox, pIdx))
                        box.delete(array.get(pSlBox, pIdx))
                        line.delete(array.get(pLine, pIdx))
                        line.delete(array.get(pTpLn, pIdx))
                        line.delete(array.get(pSlLn, pIdx))
                        label.delete(array.get(pTpLbl, pIdx))
                        label.delete(array.get(pSlLbl, pIdx))
                        label.delete(array.get(pLabel, pIdx))
                        array.remove(pOcoId, pIdx), array.remove(pSesName, pIdx), array.remove(pIsBuy, pIdx)
                        array.remove(pEntry, pIdx), array.remove(pSL, pIdx), array.remove(pTP, pIdx), array.remove(pLot, pIdx)
                        array.remove(pTradeRR, pIdx), array.remove(pIsSmall, pIdx), array.remove(pSesRange, pIdx)
                        array.remove(pTpBox, pIdx), array.remove(pSlBox, pIdx), array.remove(pLine, pIdx), array.remove(pTpLn, pIdx), array.remove(pSlLn, pIdx), array.remove(pTpLbl, pIdx), array.remove(pSlLbl, pIdx), array.remove(pLabel, pIdx)
                        array.remove(pState, pIdx), array.remove(pCreateTime, pIdx)
                    pIdx -= 1
            // Cancel 2nd order pending on new session start
            if use2ndOrder and array.size(p2SesName) > 0
                int p2x = array.size(p2SesName) - 1
                while p2x >= 0
                    if p2x < array.size(p2SesName) and array.get(p2SesName, p2x) == cancelMatchName
                        line.delete(array.get(p2PendLn, p2x))
                        line.delete(array.get(p2PendTpLn, p2x))
                        line.delete(array.get(p2PendSlLn, p2x))
                        label.delete(array.get(p2PendLb, p2x))
                        label.delete(array.get(p2PendTpLb, p2x))
                        label.delete(array.get(p2PendSlLb, p2x))
                        array.remove(p2IsBuy, p2x), array.remove(p2Entry, p2x), array.remove(p2SesRange, p2x)
                        array.remove(p2SesName, p2x), array.remove(p2OriginTime, p2x), array.remove(p2IsSmall, p2x), array.remove(p2OrigEntry, p2x), array.remove(p2PendLn, p2x), array.remove(p2PendLb, p2x)
                        array.remove(p2PendTpLn, p2x), array.remove(p2PendSlLn, p2x), array.remove(p2PendTpLb, p2x), array.remove(p2PendSlLb, p2x)
                    p2x -= 1
            // Cancel 50% add-on pending on new session start
            if useAddOn50 and array.size(aoSesName) > 0
                int aox = array.size(aoSesName) - 1
                while aox >= 0
                    if aox < array.size(aoSesName) and array.get(aoSesName, aox) == cancelMatchName
                        line.delete(array.get(aoLn, aox))
                        line.delete(array.get(aoTpLn, aox))
                        line.delete(array.get(aoSlLn, aox))
                        label.delete(array.get(aoLb, aox))
                        label.delete(array.get(aoTpLb, aox))
                        label.delete(array.get(aoSlLb, aox))
                        array.remove(aoIsBuy, aox), array.remove(aoLevel, aox), array.remove(aoTP, aox)
                        array.remove(aoSL, aox), array.remove(aoSesRange, aox), array.remove(aoSesName, aox)
                        array.remove(aoOriginTime, aox), array.remove(aoIsSmall, aox), array.remove(aoLn, aox), array.remove(aoTpLn, aox), array.remove(aoSlLn, aox)
                        array.remove(aoLb, aox), array.remove(aoTpLb, aox), array.remove(aoSlLb, aox)
                    aox -= 1
            // Close open MAIN orders on new session start
            if closeMainOnNewSes and array.size(tEntry) > 0
                int ti = array.size(tEntry) - 1
                while ti >= 0
                    if ti < array.size(tEntry) and not array.get(tIsRec, ti) and not (aoKeepOpen and array.get(tIsAddon, ti))
                        bool  isBT    = array.get(tIsBuy, ti)
                        float entT    = array.get(tEntry, ti)
                        float distT   = array.get(tPipsDist, ti)
                        float closePx = close
                        float pnlDist = isBT ? closePx - entT : entT - closePx
                        float actualR = distT > 0 ? pnlDist / distT : 0
                        bool  statAsWin = actualR > 0
                        color closeCol = statAsWin ? color.green : actualR == 0 ? color.gray : color.red
                        array.push(resIsWin, statAsWin)
                        array.push(resTradeRR, actualR)
                        array.push(resTime, array.get(tOriginTime, ti))
                        array.push(resIsSmall, array.get(tIsSmall, ti))
                        array.push(resIsRec, false)
                        array.push(resIs2nd, array.get(tIs2nd, ti))
                        array.push(resTpPts, math.abs(pnlDist))
                        if array.size(resIsWin) > 5000
                            array.shift(resIsWin), array.shift(resTradeRR), array.shift(resTime)
                            array.shift(resIsSmall), array.shift(resIsRec), array.shift(resIs2nd), array.shift(resTpPts)
                        string sesCloseTag = array.get(tIsAddon, ti) ? "ออเดอร์ที่ 2" : "ออเดอร์ที่ 1"
                        regLabel(label.new(x=bar_index, y=closePx, text="", style=label.style_circle, color=color.new(closeCol, 50), size=size.normal))
                        string rSignC = actualR >= 0 ? "+" : ""
                        regLabel(label.new(x=bar_index, y=closePx, text="Close " + sesCloseTag + "\\n" + rSignC + str.tostring(actualR, "#.##") + "R", color=color.new(color.gray, 20), textcolor=color.white, style=isBT ? label.style_label_up : label.style_label_down, size=size.small))
                        regLine(line.new(x1=bar_index - 3, y1=closePx, x2=bar_index + 3, y2=closePx, color=closeCol, width=2))
                        if showTradePath
                            regLine(line.new(x1=array.get(tBarIdx, ti), y1=entT, x2=bar_index, y2=closePx, color=color.new(closeCol, 60), width=1, style=line.style_dashed))
                        box tSlB = array.get(tSlBox, ti)
                        if not na(tSlB)
                            box.set_right(tSlB, bar_index)
                        line tTrL = array.get(tTrailLn, ti)
                        if not na(tTrL)
                            line.delete(tTrL)
                        label.delete(array.get(tAoTpLbl, ti)), label.delete(array.get(tAoSlLbl, ti))
                        line.delete(array.get(tAoTpLn, ti)),  line.delete(array.get(tAoSlLn, ti))
                        array.remove(tIsBuy, ti), array.remove(tEntry, ti), array.remove(tSL, ti), array.remove(tTP, ti)
                        array.remove(tBarIdx, ti), array.remove(tPipsDist, ti), array.remove(tTradeRR, ti), array.remove(tIsSmall, ti), array.remove(tIsRec, ti)
                        array.remove(tTrailed, ti), array.remove(tSlR, ti), array.remove(tSlBox, ti), array.remove(tTrailLn, ti), array.remove(tSesRange, ti), array.remove(tSesName, ti)
                        array.remove(tOriginTime, ti), array.remove(tOrigEntry, ti), array.remove(tIs2nd, ti), array.remove(tIsAddon, ti)
                        array.remove(tAoTpLbl, ti), array.remove(tAoSlLbl, ti), array.remove(tAoTpLn, ti), array.remove(tAoSlLn, ti), array.remove(tAddonTPd, ti)
                    ti -= 1
            s.startBar := bar_index
            s.hi := high
            s.lo := low
            if showSesRange
                s.rangeBox := box.new(left=bar_index, top=high, right=bar_index, bottom=low, bgcolor=color.new(s.boxCol, 92), border_color=color.new(s.boxCol, 60), border_style=line.style_dotted, text="", text_size=size.small, text_color=color.new(s.boxCol, 30), text_halign=text.align_center, text_valign=text.align_bottom)
                regBox(s.rangeBox)
        if is_ses and not sesStart
            s.hi := math.max(s.hi, high)
            s.lo := math.min(s.lo, low)
            if showSesRange and not na(s.rangeBox)
                box.set_top(s.rangeBox, s.hi)
                box.set_rightbottom(s.rangeBox, bar_index, s.lo)
        if sesEnd and not na(s.hi) and not na(s.lo) and (s.hi - s.lo) > 0
            bool shouldCreatePlan = true
            float effHi = s.hi
            float effLo = s.lo
            int   effStartBar = s.startBar
            string effName    = s.name
            int planDow = dayofweek(time, tz)
            bool tradeDayAllowed = switch planDow
                dayofweek.sunday    => tradeSun
                dayofweek.monday    => tradeMon
                dayofweek.tuesday   => tradeTue
                dayofweek.wednesday => tradeWed
                dayofweek.thursday  => tradeThu
                dayofweek.friday    => tradeFri
                dayofweek.saturday  => tradeSat
                => true
            if shouldCreatePlan and tradeDayAllowed and not na(effHi) and not na(effLo) and (effHi - effLo) > 0
                ocoCounter += 1
                float sesRange = effHi - effLo
                bool isSmallBox = false
                string sesDisplayName = effName
                if showSesRange and not na(s.rangeBox)
                    box.set_text(s.rangeBox, sesDisplayName)
                // BUY PLAN
                float bEntry   = effHi
                float bEntAdj  = bEntry + spreadPts
                float bOneR    = oneRDistOf(sesRange)
                float bSL      = slEdgeMode ? effLo : bEntAdj - bOneR
                float bRisk    = math.abs(bEntAdj - bSL)
                float bRewardBase = rrBaseMode == "SL Distance" ? bRisk : bOneR
                float bTP      = bEntAdj + (bRewardBase * rrRatio)
                float bLot     = bOneR > 0 ? riskAmount / (bOneR * pipValueRatio) : 0
                float bTradeRR = bOneR > 0 ? math.abs(bTP - bEntAdj) / bOneR : 0
                line bLine = line.new(x1=bar_index + 2, y1=bEntry, x2=bar_index + 10, y2=bEntry, color=color.blue, width=1, style=line.style_dashed)
                line bTpLn = line.new(x1=bar_index + 2, y1=bTP, x2=bar_index + 10, y2=bTP, color=color.green, width=1, style=line.style_dashed)
                line bSlLn = line.new(x1=bar_index + 2, y1=bSL, x2=bar_index + 10, y2=bSL, color=color.red, width=1, style=line.style_dashed)
                box bTpBx  = box.new(left=effStartBar, top=bTP, right=bar_index + 10, bottom=bEntry, bgcolor=showTpSlBox ? color.new(color.green, 90) : color.new(color.green, 100), border_color=showTpSlBox ? color.new(color.green, 50) : color.new(color.green, 100))
                box bSlBx  = box.new(left=effStartBar, top=bEntry, right=bar_index + 10, bottom=bSL, bgcolor=showTpSlBox ? color.new(color.red, 90) : color.new(color.red, 100), border_color=showTpSlBox ? color.new(color.red, 50) : color.new(color.red, 100))
                string bTxt = "ออเดอร์ที่ 1 Buy Stop\\nEntry: " + str.tostring(bEntry, format.mintick) + "\\nTP: " + str.tostring(bTP, format.mintick) + "\\nSL: " + str.tostring(bSL, format.mintick) + "\\nLot: " + str.tostring(bLot, "#.##")
                label bLab = label.new(x=bar_index + 15, y=bEntry, text=bTxt, color=color.new(color.green, 75), textcolor=color.white, style=label.style_label_left, size=orderLabelSize)
                label bTpLb = label.new(x=bar_index + 10, y=bTP, text="TP ออเดอร์ที่ 1 " + str.tostring(bTP, format.mintick), color=color.new(color.green, 80), textcolor=color.green, style=label.style_label_left, size=orderLabelSizeSm)
                label bSlLb = label.new(x=bar_index + 10, y=bSL, text="SL ออเดอร์ที่ 1 " + str.tostring(bSL, format.mintick), color=color.new(color.red, 80), textcolor=color.red, style=label.style_label_left, size=orderLabelSizeSm)
                regLine(bLine), regLine(bTpLn), regLine(bSlLn), regBox(bTpBx), regBox(bSlBx), regLabel(bLab), regLabel(bTpLb), regLabel(bSlLb)
                array.push(pOcoId, ocoCounter), array.push(pSesName, effName), array.push(pIsBuy, true)
                array.push(pEntry, bEntry), array.push(pSL, bSL), array.push(pTP, bTP), array.push(pLot, bLot), array.push(pTradeRR, bTradeRR), array.push(pIsSmall, isSmallBox), array.push(pSesRange, sesRange)
                array.push(pTpBox, bTpBx), array.push(pSlBox, bSlBx), array.push(pLine, bLine), array.push(pTpLn, bTpLn), array.push(pSlLn, bSlLn), array.push(pLabel, bLab), array.push(pTpLbl, bTpLb), array.push(pSlLbl, bSlLb)
                array.push(pState, 0), array.push(pCreateTime, time)
                sigNewOrder := true
                alert("ออเดอร์ที่ 1 Plan Buy Stop | Entry: " + str.tostring(bEntry, format.mintick) + " | TP: " + str.tostring(bTP, format.mintick) + " | SL: " + str.tostring(bSL, format.mintick) + " | Lot: " + str.tostring(bLot, "#.##"), alert.freq_once_per_bar_close)
                // SELL PLAN
                float sEntry   = effLo
                float sEntAdj  = sEntry - spreadPts
                float sOneR    = oneRDistOf(sesRange)
                float sSL      = slEdgeMode ? effHi : sEntAdj + sOneR
                float sRisk    = math.abs(sSL - sEntAdj)
                float sRewardBase = rrBaseMode == "SL Distance" ? sRisk : sOneR
                float sTP      = sEntAdj - (sRewardBase * rrRatio)
                float sLot     = sOneR > 0 ? riskAmount / (sOneR * pipValueRatio) : 0
                float sTradeRR = sOneR > 0 ? math.abs(sEntAdj - sTP) / sOneR : 0
                line sLine = line.new(x1=bar_index + 2, y1=sEntry, x2=bar_index + 10, y2=sEntry, color=color.blue, width=1, style=line.style_dashed)
                line sTpLn = line.new(x1=bar_index + 2, y1=sTP, x2=bar_index + 10, y2=sTP, color=color.green, width=1, style=line.style_dashed)
                line sSlLn = line.new(x1=bar_index + 2, y1=sSL, x2=bar_index + 10, y2=sSL, color=color.red, width=1, style=line.style_dashed)
                box sTpBx  = box.new(left=effStartBar, top=sEntry, right=bar_index + 10, bottom=sTP, bgcolor=showTpSlBox ? color.new(color.green, 90) : color.new(color.green, 100), border_color=showTpSlBox ? color.new(color.green, 50) : color.new(color.green, 100))
                box sSlBx  = box.new(left=effStartBar, top=sSL, right=bar_index + 10, bottom=sEntry, bgcolor=showTpSlBox ? color.new(color.red, 90) : color.new(color.red, 100), border_color=showTpSlBox ? color.new(color.red, 50) : color.new(color.red, 100))
                string sTxt = "ออเดอร์ที่ 1 Sell Stop\\nEntry: " + str.tostring(sEntry, format.mintick) + "\\nTP: " + str.tostring(sTP, format.mintick) + "\\nSL: " + str.tostring(sSL, format.mintick) + "\\nLot: " + str.tostring(sLot, "#.##")
                label sLab = label.new(x=bar_index + 15, y=sEntry, text=sTxt, color=color.new(color.red, 75), textcolor=color.white, style=label.style_label_left, size=orderLabelSize)
                label sTpLb = label.new(x=bar_index + 10, y=sTP, text="TP ออเดอร์ที่ 1 " + str.tostring(sTP, format.mintick), color=color.new(color.green, 80), textcolor=color.green, style=label.style_label_left, size=orderLabelSizeSm)
                label sSlLb = label.new(x=bar_index + 10, y=sSL, text="SL ออเดอร์ที่ 1 " + str.tostring(sSL, format.mintick), color=color.new(color.red, 80), textcolor=color.red, style=label.style_label_left, size=orderLabelSizeSm)
                regLine(sLine), regLine(sTpLn), regLine(sSlLn), regBox(sTpBx), regBox(sSlBx), regLabel(sLab), regLabel(sTpLb), regLabel(sSlLb)
                array.push(pOcoId, ocoCounter), array.push(pSesName, effName), array.push(pIsBuy, false)
                array.push(pEntry, sEntry), array.push(pSL, sSL), array.push(pTP, sTP), array.push(pLot, sLot), array.push(pTradeRR, sTradeRR), array.push(pIsSmall, isSmallBox), array.push(pSesRange, sesRange)
                array.push(pTpBox, sTpBx), array.push(pSlBox, sSlBx), array.push(pLine, sLine), array.push(pTpLn, sTpLn), array.push(pSlLn, sSlLn), array.push(pLabel, sLab), array.push(pTpLbl, sTpLb), array.push(pSlLbl, sSlLb)
                array.push(pState, 0), array.push(pCreateTime, time)
                alert("ออเดอร์ที่ 1 Plan Sell Stop | Entry: " + str.tostring(sEntry, format.mintick) + " | TP: " + str.tostring(sTP, format.mintick) + " | SL: " + str.tostring(sSL, format.mintick) + " | Lot: " + str.tostring(sLot, "#.##"), alert.freq_once_per_bar_close)
// ==========================================

// --- 5. TRIGGER OCO BREAKOUT & DRAWINGS ---

// ==========================================

if array.size(pTpBox) > 0
    for i = 0 to array.size(pTpBox) - 1
        box.set_right(array.get(pTpBox, i), bar_index + 3)
        box.set_right(array.get(pSlBox, i), bar_index + 3)
        line.set_x2(array.get(pLine, i), bar_index + 3)
if array.size(tSlBox) > 0
    for i = 0 to array.size(tSlBox) - 1
        box sb = array.get(tSlBox, i)
        if not na(sb)
            box.set_right(sb, bar_index + 3)
// --- Plan Expiry Check ---

if planExpireHours > 0 and array.size(pCreateTime) > 0
    int expMs = math.round(planExpireHours * 3600000)
    int ei = array.size(pCreateTime) - 1
    while ei >= 0
        if ei < array.size(pCreateTime) and (time - array.get(pCreateTime, ei)) > expMs
            bool  isBExp = array.get(pIsBuy, ei)
            float expY   = array.get(pEntry, ei)
            int   expId  = array.get(pOcoId, ei)
            string expSn = array.get(pSesName, ei)
